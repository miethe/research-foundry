   135	class AuthProviderMiddleware(BaseHTTPMiddleware):
   136	    """Registry-based auth middleware for the RF loopback API (P5.1; composite
   137	    chain added in public-multiuser Phase 2, ACT-203).
   138	
   139	    Delegates authentication to a registered
   140	    :class:`~research_foundry.api.auth.provider.AuthProvider`.  Only
   141	    instantiate when ``auth.provider != "none"`` — ``create_app`` is
   142	    responsible for that guard (security invariant: a ``None`` provider means
   143	    zero middleware is added, not a middleware that passes all requests through
   144	    unconditionally).
   145	
   146	    Middleware ordering (outermost → innermost): CORS → allowlist → auth.
   147	    Auth is innermost so it only runs after IP filtering has already passed.
   148	
   149	    Composite auth chain (ACT-203, FR-11)
   150	    --------------------------------------
   151	    Every Bearer credential is checked against the ``access_tokens`` store
   152	    (via :func:`~research_foundry.services.token_service.verify_token`)
   153	    BEFORE the configured provider adapter runs:
   154	
   155	      * Token-store HIT  → resolve identity directly from the token row; the
   156	        provider adapter (Clerk, local_static, ...) is never invoked for this
   157	        request.
   158	      * Token-store MISS (including a malformed/absent header, or a
   159	        genuinely unrecognized/expired/revoked token) → fall through
   160	        unchanged to ``self._provider.authenticate(request)``, exactly as
   161	        before ACT-203.
   162	
   163	    This lets machine tokens and human provider sessions (e.g. Clerk JWTs)
   164	    coexist without introducing a new ``auth.provider`` enum value — the
   165	    token-store check is a chain link in front of whichever provider is
   166	    configured, not a provider itself.  ``self._paths`` is ``None`` in any
   167	    test/construction path that predates ACT-203 (or that deliberately
   168	    opts out); the chain link is a no-op in that case and behavior is
   169	    byte-identical to the pre-ACT-203 provider-only path.
   170	
   171	    Security invariants
   172	    -------------------
   173	    1. ``GET /health`` is always unauthenticated — consistent with the legacy
   174	       :class:`TokenAuthMiddleware` contract and required for liveness probes.
   175	    2. ``request.state.identity`` is set only on authenticated requests.
   176	       Routes and dependencies that require authentication must check
   177	       ``getattr(request.state, "identity", None)`` — ``None`` means either
   178	       "no provider configured" or "provider rejected this request" depending
   179	       on whether middleware was added at all.
   180	    3. A generic ``{"detail": "Unauthorized"}`` 401 is returned on failure.
   181	       No provider name, token detail, or diagnostic information is included
   182	       to avoid leaking adapter topology to unauthenticated callers.
   183	    4. (ACT-203) A token-store lookup failure of ANY kind — including an
   184	       unexpected exception from ``token_service.verify_token`` — degrades
   185	       to "no match" and falls through to the provider adapter.  It never
   186	       propagates as a 500 (AC-4 resilience).
   187	    """
   188	
   189	    def __init__(
   190	        self,
   191	        app: ASGIApp,
   192	        *,
   193	        provider: AuthProvider,
   194	        paths: Optional[FoundryPaths] = None,
   195	    ) -> None:
   196	        super().__init__(app)
   197	        self._provider = provider
   198	        self._paths = paths
   199	
   200	    async def dispatch(self, request: Request, call_next: Callable) -> Response:
   201	        # GET /health is always unauthenticated (security invariant 1).
   202	        if request.url.path == _HEALTH_PATH:
   203	            return await call_next(request)
   204	
   205	        # Share token is the credential; sensitivity re-check happens inside
   206	        # the resolver (PRD AC-2).  This exemption is PRECISELY scoped:
   207	        #   - only GET (not POST/PATCH/DELETE)
   208	        #   - only the /api/reports/shares/{token} path (token must be non-empty)
   209	        #   - all other /api/reports/* routes still require session auth
   210	        if (
   211	            request.method == "GET"
   212	            and request.url.path.startswith(_SHARE_TOKEN_PATH_PREFIX)
   213	            and len(request.url.path) > len(_SHARE_TOKEN_PATH_PREFIX)
   214	        ):
   215	            return await call_next(request)
   216	
   217	        identity = self._authenticate(request)
   218	        if identity is None:
   219	            # Return a generic 401 — do not leak provider name or token detail
   220	            # (security invariant 3).
   221	            return JSONResponse({"detail": "Unauthorized"}, status_code=401)
   222	
   223	        # Attach the resolved identity to request state for downstream
   224	        # consumers (e.g. require_role dependency introduced in P5.2).
   225	        request.state.identity = identity
   226	        return await call_next(request)
   227	
   228	    def _authenticate(self, request: Request) -> Optional[AuthIdentity]:
   229	        """Resolve an identity: token-store first, provider fallthrough (ACT-203)."""
   230	        if self._paths is not None:
   231	            # Pass the narrowed `self._paths` as an argument (rather than
   232	            # re-reading `self._paths` inside `_resolve_token_identity`) so
   233	            # the None-check above is visible to static type checking too.
   234	            token_identity = self._resolve_token_identity(request, self._paths)
   235	            if token_identity is not None:
   236	                return token_identity
   237	        return self._provider.authenticate(request)
   238	
   239	    def _resolve_token_identity(
   240	        self, request: Request, paths: FoundryPaths
   241	    ) -> Optional[AuthIdentity]:
   242	        """Check the Bearer credential against the access_tokens store.
   243	
   244	        Returns ``None`` (never raises) for: no/malformed Authorization
   245	        header, an empty Bearer value, or any ``token_service.verify_token``
   246	        outcome that is not a hit (unrecognized/expired/revoked token, or an
   247	        unexpected exception from the token-store lookup itself — security
   248	        invariant 4 above).
   249	        """
   250	        auth_header = request.headers.get("Authorization", "")
   251	        if not auth_header.startswith("Bearer "):
   252	            return None
   253	        supplied = auth_header[len("Bearer "):]
   254	        if not supplied:
   255	            return None
   256	
   257	        try:
   258	            resolved = token_service.verify_token(paths, supplied)
   259	        except Exception:  # noqa: BLE001 — fail-soft: never let a token-store
   260	            # bug turn into a 500; fall through to the provider adapter instead.
   261	            logger.warning(
   262	                "AuthProviderMiddleware: token_service.verify_token raised; "
   263	                "falling through to the configured provider adapter.",
   264	                exc_info=True,
   265	            )
   266	            return None
   267	
   268	        if resolved is None:
   269	            return None
   270	
   271	        return AuthIdentity(
   272	            user_id=resolved.principal_id,
   273	            workspace_id=resolved.workspace_id,
   274	            roles=(resolved.role,),
   275	        )
   276	
   277	
   278	__all__ = ["TokenAuthMiddleware", "AuthProviderMiddleware"]

