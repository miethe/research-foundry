    75	# Label markers that exempt a sentence from the "material claim needs a tag" rule.
    76	_LABEL_PATTERNS = {
    77	    "inference": re.compile(r"\*\*\s*Inference\s*:?\s*\*\*", re.IGNORECASE),
    78	    "speculation": re.compile(r"\*\*\s*Speculation\s*:?\s*\*\*", re.IGNORECASE),
    79	    "mixed": re.compile(r"\*\*\s*Mixed evidence\s*:?\s*\*\*", re.IGNORECASE),
    80	    "contradicted": re.compile(r"\*\*\s*Contradicted", re.IGNORECASE),
    81	}
    82	
    83	_CLAIM_TAG = re.compile(r"\[claim:([A-Za-z0-9_\-]+)\]")
    84	
    85	# Per-type heuristics for classifying a sentence as a material claim. These are
    86	# intentionally conservative-but-real: they fire on the kinds of sentences a
    87	# reader could rely on as fact (numbers, comparisons, attributions, advice,
    88	# predictions). Sections like "Open questions" / "Sources" are excluded by the
    89	# caller, and labeled/tagged sentences are exempt regardless.
    90	_MATERIAL_HEURISTICS: dict[str, re.Pattern[str]] = {
    91	    "quantitative": re.compile(
    92	        r"\b\d[\d,\.]*\s*(?:%|percent|queries|tokens|ms|seconds|x|times|"
    93	        r"million|billion|thousand|k\b|gb|mb|requests|docs|documents|cases|"
    94	        r"samples|rows|users|hours|days|years)?\b",
    95	        re.IGNORECASE,
    96	    ),
    97	    "comparative": re.compile(
    98	        r"\b(?:more|less|faster|slower|better|worse|higher|lower|cheaper|"
    99	        r"superior|inferior|outperform[s]?|than)\b",
   100	        re.IGNORECASE,
   101	    ),
   102	    "recommendation": re.compile(
   103	        r"\b(?:use|adopt|prefer|recommend(?:ed)?|should|must|avoid|choose)\b",
   104	        re.IGNORECASE,
   105	    ),
   106	    "attribution": re.compile(
   107	        r"\b(?:according to|says?|claims?|states?|reports?|per the|the vendor|"
   108	        r"the authors?|the paper)\b",
   109	        re.IGNORECASE,
   110	    ),
   111	    "causal": re.compile(
   112	        r"\b(?:because|causes?|caused|leads? to|results? in|reduces?|increases?|"
   113	        r"improves?|enables?|prevents?|due to)\b",
   114	        re.IGNORECASE,
   115	    ),
   116	    "prediction": re.compile(
   117	        r"\b(?:will|likely|expected to|going to|in the future|forecast|"
   118	        r"projected)\b",
   119	        re.IGNORECASE,
   120	    ),
   121	    # 'factual' is the broadest: a declarative sentence asserting a state of the
   122	    # world ("X supports Y", "X is Y"). We require a finite verb signal so that
   123	    # questions and fragments are not swept in.
   124	    "factual": re.compile(
   125	        r"\b(?:is|are|was|were|supports?|provides?|includes?|contains?|has|have|"
   126	        r"requires?|consists? of|comprises?)\b",
   127	        re.IGNORECASE,
   128	    ),
   129	}
   130	
   131	_SENTENCE_SPLIT = re.compile(r"(?<=[.!?])\s+")
   132	
   133	# HTML comment span. The synthesizer emits empty-section placeholders as whole-line
   134	# comments (e.g. ``<!-- No supported findings for this run. -->``). We strip comment
   135	# spans rather than dropping the whole line, so a real claim after an inline comment
   136	# is still classified (closes the "<!-- note --> <claim>" laundering hole).
   137	_HTML_COMMENT = re.compile(r"<!--.*?-->", re.DOTALL)
