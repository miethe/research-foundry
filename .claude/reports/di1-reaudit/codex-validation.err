   598	        write_evidence_plan(plan_dict, rp.run / "research_evidence_plan.yaml")
   599	
   600	    if plan_dict is not None and retrieval_policy != "disabled":
   601	        residual_questions = [q for q in plan_dict.get("questions", []) if q.get("coverage_state") == "residual"]
