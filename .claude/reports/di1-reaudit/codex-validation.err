   643	
   644	    Returns the full updated draft (200) — R2 fix: this previously answered
   645	    204 No Content while ``builder_service.delete_block`` already computed
   646	    and returned the updated draft, so the frontend's ``Promise<ReportDraft>``
   647	    client (which writes the response straight into the React Query cache)
   648	    silently stomped the cache with ``undefined``. Matches the sibling
   649	    ``add_block``/``update_block``/``reorder_blocks`` contract.
   650	    """
   651	    identity = getattr(request.state, "identity", None)
   652	    try:
   653	        bsvc.load_draft(paths, report_id, identity=identity)
   654	    except NotFoundError as exc:
   655	        raise _not_found(report_id) from exc
   656	    try:
   657	        return stamp(bsvc.delete_block(paths, report_id, block_id))
   658	    except NotFoundError as exc:
   659	        raise HTTPException(
   660	            status_code=404,
   661	            detail=f"block not found: {block_id}",
   662	        ) from exc
