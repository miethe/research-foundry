   317	    generated_at: str,
   318	    paths: FoundryPaths,
   319	) -> dict[str, Any]:
   320	    """CARP-4.1: treat this search request's own ``query`` as ONE evidence-
   321	    plan question and evaluate it through the P2 adapter + P3 planner
   322	    (:func:`build_evidence_plan`) -- never the ledger, never a provider.
   323	
   324	    ``sensitivity_threshold`` is threaded through verbatim, never defaulted:
   325	    an omitted threshold makes every candidate deny with
   326	    ``sensitivity_denied`` (fail-closed by the adapter's own design, not a
   327	    bug this function papers over -- see
   328	    ``catalog_retrieval.RetrievalConstraints``).
   329	
   330	    ``automated_reuse_allowed`` is resolved from the SAME source
   331	    ``run_launch.py:195`` uses -- ``FoundryConfig(paths).assertion_ledger_capabilities()``.
   332	    Never hardcoded to ``True``; a deployment with automated reuse disabled
   333	    resolves every otherwise-eligible candidate to ``residual``/``reuse_denied``,
   334	    the same fail-closed outcome the ledger seam already produces.
   335	    """
   336	
   337	    from research_foundry.config import FoundryConfig  # local: avoid top-level cycle risk
   338	
   339	    capabilities = FoundryConfig(paths=paths).assertion_ledger_capabilities()
   340	
   341	    question = _evidence_plan_question(run_id, query)
   342	    request = EvidencePlanRequest(
   343	        evidence_plan_id=f"evp_{run_id}",
   344	        workspace_id=identity.workspace_id if identity is not None else "",
   345	        retrieval_policy=retrieval_policy,
   346	        questions=(question,),
   347	        schema_version="1",
   348	        brief_id=None,
   349	        run_id=run_id,
   350	        generated_at=generated_at,
