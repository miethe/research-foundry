   260	
   261	def _emit_otel_record_success(audit_event_id: str, event: AuditEvent) -> None:
   262	    """Emit an OTel success span if OTel is available (best-effort)."""
   263	    try:
   264	        from opentelemetry import trace  # type: ignore[import]
   265	
   266	        tracer = trace.get_tracer("research_foundry.audit_service")
   267	        with tracer.start_as_current_span("audit_service.record_event") as span:
   268	            span.set_attribute("audit_event_id", audit_event_id)
   269	            span.set_attribute("mutation_type", event.mutation_type)
   270	            span.set_attribute("action", event.action)
   271	    except Exception:
   272	        pass
