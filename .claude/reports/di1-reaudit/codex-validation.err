   253	        super().__init__(app)
   254	        self._limiter = SlidingWindowRateLimiter(requests_per_window, window_seconds)
   255	
   256	    async def dispatch(self, request: Request, call_next: Callable) -> Response:
   257	        # GET /health is always exempt.
   258	        if request.url.path == _HEALTH_PATH:
   259	            return await call_next(request)
   260	
   261	        # auth_mode=none → no identity on request.state → exempt (cannot key).
   262	        identity = getattr(request.state, "identity", None)
   263	        if identity is None:
   264	            return await call_next(request)
   265	
   266	        user_id: str = identity.user_id
   267	        route: str = request.url.path
   268	
   269	        # Read runtime overrides set by PATCH /api/admin/rate-limit-config.
   270	        # These are applied per-request so changes take effect immediately
   271	        # without rebuilding the limiter or restarting the process.
   272	        _app_state = getattr(getattr(request, "app", None), "state", None)
   273	        _overrides: dict = getattr(_app_state, "rate_limit_overrides", None) or {}
   274	        limit_override: int | None = _overrides.get("max_requests")
   275	        window_override: int | None = _overrides.get("window_seconds")
   276	
   277	        # Belt-and-suspenders: ignore any non-positive override that the admin
   278	        # PATCH handler should already have blocked.  A zero or negative
   279	        # max_requests would deny every request (availability break); a zero
   280	        # or negative window_seconds corrupts the sliding-window semantics.
   281	        if limit_override is not None and limit_override <= 0:
