   100	# ---------------------------------------------------------------------------
   101	# Data classes
   102	# ---------------------------------------------------------------------------
   103	
   104	
   105	@dataclasses.dataclass(frozen=True)
   106	class AuditEvent:
   107	    """Immutable descriptor for a single governed mutation event.
   108	
   109	    Required fields (``mutation_type``, ``action``, ``target_ref``) must always
   110	    be present.  All other fields are optional/nullable and match the
   111	    ``audit_event`` column set exactly.
   112	
   113	    ``policy_snapshot`` is serialised to JSON on write; pass a plain ``dict``.
   114	    """
   115	
   116	    mutation_type: str  # must be one of MUTATION_TYPES
   117	    action: str         # e.g. import_run, create_draft, delete_draft, ingest_source
   118	    target_ref: str     # run_id / report_draft_id / source_card_id / etc.
   119	
   120	    actor_user_id: Optional[str] = None
   121	    actor_workspace_id: Optional[str] = None
   122	    source_ref: Optional[str] = None
   123	    policy_snapshot: Optional[dict[str, Any]] = None
   124	    result: str = "success"          # success | failure | denied
   125	    error_detail: Optional[str] = None
   126	    trace_id: Optional[str] = None
   127	    span_id: Optional[str] = None
   128	
   129	
   130	# ---------------------------------------------------------------------------
   131	# Secret redaction helper
   132	# ---------------------------------------------------------------------------
   133	
   134	
   135	def _redact_error_detail(text: Optional[str]) -> Optional[str]:
   136	    """Return ``text`` with any detected secrets replaced by a placeholder.
   137	
   138	    Uses ``governance.scan_secrets`` when available.  Falls back to the
   139	    raw text (with a WARNING) if governance is not importable -- this keeps
   140	    the fail-open write path free from import-chain failures while ensuring
   141	    that any redaction gap is explicitly logged.
   142	    """
   143	    if text is None:
   144	        return None
   145	    try:
   146	        from research_foundry.services.governance import _redact, scan_secrets  # type: ignore[attr-defined]
   147	
   148	        hits = scan_secrets(text)
   149	        if not hits:
   150	            return text
   151	        result = text
   152	        for secret in hits:
   153	            result = result.replace(secret, _redact(secret))
   154	        return result
   155	    except Exception as exc:  # pragma: no cover -- governance import failure
   156	        log.warning(
   157	            "audit_service: governance redaction unavailable -- storing error_detail as-is",
   158	            extra={"redaction_error": str(exc)},
   159	        )
   160	        return text
   161	
   162	
   163	# ---------------------------------------------------------------------------
   164	# Write entrypoint -- fail-open, never raises
   165	# ---------------------------------------------------------------------------
   166	
   167	
   168	def record_event(paths: FoundryPaths, event: AuditEvent) -> Optional[str]:
   169	    """Record a governed mutation event.  **Fail-open -- never raises.**
   170	
   171	    Generates a UUID4 ``audit_event_id`` and an ISO-8601 UTC ``created_at``
   172	    timestamp, redacts ``error_detail`` through governance secret-scan, then
   173	    inserts a row into ``audit_event``.
   174	
   175	    Returns the ``audit_event_id`` string on success, or ``None`` on any
   176	    failure (the failure is logged at ERROR level and, if OTel is available,
   177	    reported as an error span).
   178	
   179	    This function must be called after the primary mutations own commit,
   180	    never inside the same transaction -- that is what makes the fail-open
   181	    guarantee real rather than aspirational.
   182	    """
   183	    try:
   184	        return _record_event_inner(paths, event)
   185	    except Exception as exc:
   186	        _emit_record_error(exc, event)
   187	        return None
