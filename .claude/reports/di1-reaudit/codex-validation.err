    30	) -> FoundryConfig:
    31	    """Create a minimal workspace with the given top-level flag value.
    32	
    33	    Unlike the full RBAC toggle suite's ``_make_config`` helper, this does
    34	    not need to copy the full distribution (schemas/config/templates) or
    35	    stand up a FastAPI app — the parser and resolver under test only read
    36	    ``foundry.yaml``. ``provider``/``bind_host`` are optional and only
    37	    needed by the resolver test matrix (``TestResolveWorkspaceIsolationEnforced``);
    38	    the parser tests above ignore them.
    39	    """
    40	    root = tmp_path / "fdry"
    41	    root.mkdir(parents=True, exist_ok=True)
    42	    foundry: dict = {"owner": "Test"}
    43	    if workspace_isolation_enforcement is not None:
    44	        foundry["workspace_isolation_enforcement"] = workspace_isolation_enforcement
    45	    if bind_host is not None:
    46	        foundry["viewer"] = {"bind_host": bind_host}
    47	    if provider is not None:
    48	        foundry["auth"] = {"provider": provider}
    49	    dump_yaml({"foundry": foundry}, root / "foundry.yaml")
    50	    return FoundryConfig(paths=FoundryPaths(root=root))
