  1038	@router.get(
  1039	    "/admin/pats",
  1040	    summary="List personal access tokens (self, or any via owner/admin)",
  1041	    tags=["admin"],
  1042	)
  1043	def list_pats(
  1044	    request: Request,
  1045	    user_id: Optional[str] = Query(None, description="Target user id (defaults to caller)"),
  1046	    limit: int = Query(50, ge=1, le=200, description="Page size"),
  1047	    offset: int = Query(0, ge=0, description="Number of items to skip"),
  1048	    paths: FoundryPaths = _PATHS_DEP,
  1049	) -> dict[str, Any]:
  1050	    """List PATs.
  1051	
  1052	    Defaults to the caller's OWN PATs. Passing ``user_id`` to target a
  1053	    DIFFERENT user requires owner/admin (403 — never a silently-empty list,
  1054	    so a caller can't mistake "no permission" for "no PATs").
  1055	
  1056	    In single-operator/no-auth mode (no caller identity), an omitted
  1057	    ``user_id`` lists every PAT in the workspace — matches this router's
  1058	    existing no-identity passthrough (see ``require_role``'s absent-identity
  1059	    semantics).
  1060	    """
  1061	    identity = _get_identity(request)
  1062	    workspace_id = _resolve_workspace_id(request)
  1063	
  1064	    target_user_id = user_id
  1065	    if identity is not None:
  1066	        if target_user_id is None:
  1067	            target_user_id = identity.user_id
  1068	        elif target_user_id != identity.user_id and not _is_owner_or_admin(identity):
  1069	            raise HTTPException(
  1070	                status_code=403,
  1071	                detail="Insufficient role to list another user's PATs",
  1072	            )
  1073	
  1074	    rows = token_service.list_tokens(
  1075	        paths,
  1076	        workspace_id=workspace_id,
  1077	        principal_id=target_user_id,
  1078	        principal_type="user_pat",
  1079	    )
  1080	    return _paginate([_token_metadata(r) for r in rows], limit=limit, offset=offset)
