   185	
   186	def _get_identity(request: Request) -> Optional[Any]:
   187	    """Return ``request.state.identity`` (an ``AuthIdentity``) or ``None``.
   188	
   189	    Thin, named wrapper around the ``getattr(..., None)`` pattern used
   190	    throughout this router — kept as a single call site for the Phase 3
   191	    token/PAT routes below, which (unlike the pre-existing routes) need to
   192	    branch on identity presence/role for manual, request-content-dependent
   193	    RBAC (see the module docstring's "Self-service exceptions" section).
   194	    """
   195	    return getattr(request.state, "identity", None)
   196	
   197	
   198	def _is_owner_or_admin(identity: Optional[Any]) -> bool:
   199	    """True when *identity* is present and carries the owner or admin role."""
   200	    if identity is None:
   201	        return False
   202	    return bool({"owner", "admin"} & set(identity.roles))
