  1157	
  1158	def export_markdown(
  1159	    paths: FoundryPaths,
  1160	    report_draft_id: str,
  1161	    *,
  1162	    identity: AuthIdentity | None = None,
  1163	) -> str:
  1164	    """Render the draft to Markdown with frontmatter + stable ``[claim:]`` tags.
  1165	
  1166	    Blocks already carry ``[claim:<id>]`` tags inline (added by
  1167	    :func:`add_claim_link`), so this is a structural frontmatter+body join,
  1168	    not a second claim-linking pass.
  1169	
  1170	    ``identity`` is WKSP-304 Phase 3 query-layer scoping — threaded straight
  1171	    into :func:`load_draft`, which raises :class:`NotFoundError` for a
  1172	    cross-workspace draft when isolation is active. ``identity=None`` (the
  1173	    default) is byte-identical to the pre-WKSP-304 export.
  1174	    """
  1175	
  1176	    draft = load_draft(paths, report_draft_id, identity=identity)
  1177	    frontmatter = {
  1178	        "schema_version": "1.0",
  1179	        "type": "research_report",
  1180	        "report_id": draft["report_draft_id"],
  1181	        "title": draft["title"],
  1182	        "status": draft.get("status"),
  1183	        "audience": draft.get("audience"),
  1184	        "sensitivity": draft.get("sensitivity"),
  1185	        "created_at": draft.get("created_at"),
  1186	        "updated_at": draft.get("updated_at"),
  1187	    }
  1188	    lines: list[str] = []
  1189	    for block in sorted(draft["blocks"], key=lambda b: b["order"]):
  1190	        text = (block.get("markdown") or "").strip()
  1191	        if not text:
  1192	            continue
  1193	        if block["block_type"] == "heading":
  1194	            lines.append(text if text.startswith("#") else f"## {text}")
  1195	        else:
  1196	            lines.append(text)
  1197	        lines.append("")
  1198	    body = "\n".join(lines).strip() + "\n"
  1199	    return join_frontmatter(frontmatter, body)
