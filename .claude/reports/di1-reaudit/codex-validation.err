   717	    span_end: int | None = None,
   718	    insert_tag: bool = True,
   719	    updated_by: str | None = None,
   720	) -> dict[str, Any]:
   721	    """Link *claim_id* to *block_id* (spec §7 Report Location V2 / §8 claim_links[]).
   722	
   723	    When *insert_tag* is true (default) and the block's markdown does not
   724	    already carry a ``[claim:<claim_id>]`` tag, one is appended — this is
   725	    what makes the eventual :func:`export_markdown` output's claim
   726	    references "stable" (spec §8): the tag always lives in the persisted
   727	    block text, never only in structured metadata.
   728	
   729	    *span_start*/*span_end* are character offsets into the block's
   730	    *normalized* markdown (spec §7 Report Location V2) for a caller that
   731	    knows which excerpt it linked (e.g. a future "select text, link claim"
   732	    Builder UI action). Omitted (the common case — linking a whole
   733	    paragraph, or importing a bare ``[claim:]`` tag from a run), the span
   734	    defaults to the *entire* normalized block — one hash validates "this
   735	    paragraph is unchanged", matching P2's per-block ``text_hash`` semantics
   736	    (D8) rather than the narrow tag-marker text.
   737	    """
   738	
   739	    draft = load_draft(paths, report_draft_id)
   740	    block = _find_block(draft, block_id)
   741	
   742	    if insert_tag and not re.search(rf"\[claim:{re.escape(claim_id)}\]", block["markdown"]):
   743	        block["markdown"] = (block["markdown"].rstrip() + f" [claim:{claim_id}]").strip()
   744	
   745	    resolved = _resolve_claim(
   746	        paths, catalog_item_id=catalog_item_id, source_run_id=source_run_id, claim_id=claim_id
   747	    )
   748	    link_status = "linked" if resolved is not None else "missing_claim"
   749	    if relation is None:
   750	        relation = _RELATION_BY_CLAIM_STATUS.get(str((resolved or {}).get("status")), "context")
   751	    elif relation not in RELATIONS:
   752	        raise BuilderError(f"unknown relation: {relation!r}; expected one of {RELATIONS}")
   753	
   754	    normalized = _normalize_text(block["markdown"])
   755	    start = span_start if span_start is not None else 0
   756	    end = span_end if span_end is not None else len(normalized)
   757	    quote_text_hash = _text_hash(normalized[start:end]) if normalized else None
   758	
   759	    seq = _next_seq(draft, "claim_link")
   760	    link = {
   761	        "claim_link_id": _mint_claim_link_id(report_draft_id, seq),
   762	        "block_id": block_id,
   763	        "claim_id": claim_id,
   764	        "source_run_id": source_run_id,
   765	        "catalog_item_id": catalog_item_id,
   766	        "relation": relation,
   767	        "span_start": start,
   768	        "span_end": end,
   769	        "quote_text_hash": quote_text_hash,
   770	        "link_status": link_status,
   771	    }
   772	    draft["claim_links"].append(link)
   773	    _recompute_block_coverage(draft, block_id)
   774	    _touch(draft, updated_by)
   775	    return _save_draft(paths, draft)
   776	
   777	
   778	def remove_claim_link(
   779	    paths: FoundryPaths, report_draft_id: str, claim_link_id: str, *, updated_by: str | None = None
   780	) -> dict[str, Any]:
   781	    draft = load_draft(paths, report_draft_id)
   782	    target = next((cl for cl in draft["claim_links"] if cl["claim_link_id"] == claim_link_id), None)
   783	    if target is None:
   784	        raise NotFoundError(f"claim link not found: {claim_link_id}")
   785	    draft["claim_links"] = [cl for cl in draft["claim_links"] if cl["claim_link_id"] != claim_link_id]
   786	    _recompute_block_coverage(draft, target["block_id"])
   787	    _touch(draft, updated_by)
   788	    return _save_draft(paths, draft)
