     1	"""Report Builder API router — Phase 3 Wave E.
     2	
     3	All paths route through :mod:`~research_foundry.services.builder_service`
     4	(file-canonical draft store, Wave D) and
     5	:func:`~research_foundry.services.verification.verify_draft` (D13 checks).
     6	No auth/RBAC (deferred to P5 D12). Draft truth stays in files; this router
     7	is a thin HTTP wrapper.
     8	
     9	Route table (registered under /api prefix in app.py):
    10	
    11	  POST   /reports                               create draft (blank / from-run / from-collection)
    12	  GET    /reports                               list drafts (sensitivity-gated, fail-closed)
    13	  GET    /reports/{report_id}                   load draft (rpt_ id only; sensitivity-gated)
    14	  DELETE /reports/{report_id}                   delete draft
    15	  GET    /reports/{report_id}/versions          list revisions
    16	  POST   /reports/{report_id}/versions          create revision snapshot
    17	  GET    /reports/{report_id}/versions/{vid}    get revision snapshot
    18	  POST   /reports/{report_id}/versions/{vid}/restore  restore revision
    19	  POST   /reports/{report_id}/blocks            add block
    20	  PATCH  /reports/{report_id}/blocks/reorder    reorder blocks (fixed before param)
    21	  PATCH  /reports/{report_id}/blocks/{block_id} update block
    22	  DELETE /reports/{report_id}/blocks/{block_id} delete block (200 + updated draft)
    23	  POST   /reports/{report_id}/claim-links       add claim link
    24	  DELETE /reports/{report_id}/claim-links/{claim_link_id}   remove claim link (200 + updated draft)
    25	  POST   /reports/{report_id}/source-links      add source link
    26	  DELETE /reports/{report_id}/source-links/{source_link_id} remove source link (200 + updated draft)
    27	  POST   /reports/{report_id}/verify            run D13 checks (structured result)
    28	  POST   /reports/{report_id}/publish-preview   D13 fail-closed gate + Markdown preview
    29	  GET    /reports/{report_id}/export            export draft as Markdown
    30	
    31	Critical routing note:
    32	  GET /api/reports/{run_id}/anchors is defined in runs.py.  That route has a
    33	  fixed '/anchors' suffix (4-segment path) vs this router's bare
    34	  '/reports/{report_id}' (3-segment path).  FastAPI resolves them
    35	  unambiguously by path-segment count + fixed component.  No changes to the
    36	  anchors route are needed.
    37	
    38	Id validation note (R2 CRITICAL fix):
    39	  ``report_draft_id``/``report_version_id`` shape validation and filesystem
    40	  containment now live in ``builder_service`` (``_validate_draft_id`` /
    41	  ``_validate_version_id`` / ``_draft_dir`` / ``_revision_path``), not here —
    42	  a router-level ``report_id.startswith("rpt_")`` check is a PREFIX check
    43	  that a traversal payload satisfies unchanged. Every handler below relies on
    44	  the service layer raising :class:`NotFoundError` for a malformed id, which
    45	  is caught and mapped to the same indistinguishable 404 as "doesn't exist"
    46	  (landmine #4), so a CLI caller or any other direct ``builder_service``
    47	  consumer gets the identical protection.
    48	"""
    49	
    50	from __future__ import annotations
    51	
    52	from typing import Any
    53	
    54	from fastapi import APIRouter, Depends, HTTPException, Query, Request
    55	from pydantic import BaseModel
    56	
    57	from ...errors import NotFoundError
    58	from ...paths import FoundryPaths
    59	from ...services import audit_service
    60	from ...services import builder_service as bsvc
    61	from ...services.audit_service import AuditEvent
    62	from ...services.export_service import SENSITIVITY_ORDER, ExportError, resolve_threshold
    63	from ...services.verification import verify_draft
    64	from ..auth.rbac import require_role
    65	from ..response_stamp import stamp
    66	from .runs import _sensitivity_threshold_override, get_paths
    67	
    68	router = APIRouter()
    69	
    70	_PATHS_DEP = Depends(get_paths)
    71	
    72	# RBAC-004: report mutation gates — module-level to avoid ruff B008 and to allow
    73	# test dependency_overrides on the inner callable.
    74	#
    75	# builder_service.py bypass confirmation (RBAC-004 invariant): builder_service.py
    76	# has no HTTP entry point — its write methods (create_draft, add_block, etc.) are
    77	# pure Python functions called only from this router. There is no HTTP path into
    78	# builder_service mutation functions that bypasses the router-layer gating below.
