    83	class TestResolveWorkspaceIsolationEnforced:
    84	    """Unit tests for FoundryConfig.resolve_workspace_isolation_enforced()
    85	    (WKSP-304 TASK-1.2).
    86	
    87	    Mirrors ``TestResolveRbacEnforced`` in test_rbac_enforcement_toggle.py,
    88	    but note the ``AUTO`` truth table differs deliberately: this resolver's
    89	    ``AUTO`` branch returns the literal provider-keyed bool (``provider !=
    90	    "none"``), whereas ``resolve_rbac_enforced``'s ``AUTO`` branch always
    91	    returns ``True`` (RBAC's provider-keyed semantics are realized via the
    92	    identity-None passthrough in ``require_role`` instead). See the
    93	    docstring on ``resolve_workspace_isolation_enforced`` for the full
    94	    reasoning.
    95	    """
    96	
    97	    def test_auto_none_provider_is_false(self, tmp_path):
    98	        """AUTO + provider=none → advisory-only (False), unlike resolve_rbac_enforced."""
    99	        cfg = _make_config(tmp_path, workspace_isolation_enforcement="auto")
   100	        assert cfg.resolve_workspace_isolation_enforced("none", "127.0.0.1") is False
   101	
   102	    def test_auto_local_static_is_true(self, tmp_path):
   103	        """AUTO + provider != none → enforced (True)."""
   104	        cfg = _make_config(tmp_path, workspace_isolation_enforcement="auto")
   105	        assert cfg.resolve_workspace_isolation_enforced("local_static", "127.0.0.1") is True
   106	
   107	    def test_enabled_is_always_true(self, tmp_path):
   108	        """ENABLED forces True regardless of provider."""
   109	        cfg = _make_config(tmp_path, workspace_isolation_enforcement="enabled")
   110	        assert cfg.resolve_workspace_isolation_enforced("none", "127.0.0.1") is True
   111	
   112	    def test_disabled_loopback_is_false(self, tmp_path):
   113	        """DISABLED + loopback bind → allowed, returns False."""
   114	        cfg = _make_config(
   115	            tmp_path, workspace_isolation_enforcement="disabled", bind_host="127.0.0.1"
   116	        )
   117	        assert cfg.resolve_workspace_isolation_enforced("none", "127.0.0.1") is False
   118	
   119	    def test_disabled_nonloopback_raises(self, tmp_path):
   120	        """DISABLED + non-loopback bind → fail-closed ValueError."""
   121	        cfg = _make_config(
   122	            tmp_path, workspace_isolation_enforcement="disabled", bind_host="0.0.0.0"
   123	        )
   124	        with pytest.raises(ValueError, match="non-loopback"):
   125	            cfg.resolve_workspace_isolation_enforced("none", "0.0.0.0")
   126	
   127	    def test_disabled_lan_ip_raises(self, tmp_path):
   128	        """DISABLED + LAN-routable IP (not loopback) → also refused."""
