   273	
   274	def main() -> None:
   275	    """Module entry point: build the server and run it on stdio.
   276	
   277	    Wired to ``python -m research_foundry.services.search_router.mcp_server``.
   278	    Tests cannot exercise the live transport without the ``mcp`` SDK
   279	    installed — that is expected.
   280	    """
   281	
   282	    server = build_server()
