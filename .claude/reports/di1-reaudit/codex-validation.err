  1205	
  1206	
  1207	def _summary_of(draft: dict[str, Any]) -> dict[str, Any]:
  1208	    return {
  1209	        "report_draft_id": draft["report_draft_id"],
  1210	        "title": draft["title"],
  1211	        "status": draft.get("status"),
  1212	        "sensitivity": draft.get("sensitivity"),
  1213	        "audience": draft.get("audience"),
  1214	        "origin": draft.get("origin"),
  1215	        "project_id": draft.get("project_id"),
  1216	        "workspace_id": draft.get("workspace_id"),
  1217	        "created_by": draft.get("created_by"),
  1218	        "current_version_id": draft.get("current_version_id"),
  1219	        "block_count": len(draft.get("blocks") or []),
  1220	        "claim_link_count": len(draft.get("claim_links") or []),
  1221	        "source_link_count": len(draft.get("source_links") or []),
  1222	        "created_at": draft.get("created_at"),
  1223	        "updated_at": draft.get("updated_at"),
  1224	    }
  1225	
  1226	
  1227	def _sync_catalog_index(paths: FoundryPaths, draft: dict[str, Any]) -> None:
  1228	    """Upsert *draft*'s row + ``catalog_links`` edges into the derived index.
  1229	
  1230	    ``derived_from`` links the draft to its originating run's synthetic P1
  1231	    ``report`` catalog item (when created via :func:`create_draft_from_run`);
  1232	    ``cites`` links every claim/source the draft references that has a known
  1233	    ``catalog_item_id`` (D11).
  1234	    """
  1235	
  1236	    report_draft_id = draft["report_draft_id"]
  1237	    entry = _summary_of(draft)
  1238	    entry["draft_path"] = str(_draft_yaml_path(paths, report_draft_id))
  1239	
  1240	    links: list[dict[str, str]] = []

