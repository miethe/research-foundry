   301	
   302	def load_draft(
   303	    paths: FoundryPaths,
   304	    report_draft_id: str,
   305	    *,
   306	    identity: AuthIdentity | None = None,
   307	) -> dict[str, Any]:
   308	    """Load a draft's current state from disk. Raises :class:`NotFoundError`.
   309	
   310	    ``identity`` is WKSP-304 Phase 3 query-layer scoping (see
   311	    :func:`_isolation_active`). This module has no SQL query to add an
   312	    ``AND workspace_id = ?`` predicate to (drafts are file-canonical, per the
   313	    module docstring) — the file-storage equivalent of that predicate is
   314	    applied here: when ``identity`` is not ``None`` and isolation is
   315	    actively enforced, a draft whose ``workspace_id`` does not match
   316	    ``identity.workspace_id`` is treated exactly like a missing draft
   317	    (:class:`NotFoundError`), the same fail-closed contract every other
   318	    "not visible" case in this codebase uses (e.g. catalog_service.get_item's
   319	    over-threshold items). ``identity=None`` (the default) is byte-identical
   320	    to the pre-WKSP-304 behavior — every existing caller (:func:`list_drafts`,
   321	    :func:`export_markdown`, revision helpers) that does not pass ``identity``
   322	    is unaffected.
   323	
   324	    WKSP-304 Phase 4 (TASK-4.2, OQ-1): the file-storage predicate below is
   325	    this module's query-layer-equivalent deny mechanism — on an enforcing-
   326	    mode mismatch it raises :class:`NotFoundError` (silent 404, same
   327	    exception a genuinely-missing draft already raises) *and* emits a
   328	    structured ``ERROR``-level denial log, distinct from scope.py's
   329	    advisory-mode ``WARNING`` below it.
   330	    """
   331	
   332	    path = _draft_yaml_path(paths, report_draft_id)
   333	    if not path.exists():
   334	        raise NotFoundError(f"report draft not found: {report_draft_id}")
   335	    data = load_yaml(path)
   336	    if not isinstance(data, dict):
   337	        raise BuilderError(f"malformed draft.yaml: {path}")
   338	
   339	    if identity is not None and _isolation_active(paths):
   340	        if data.get("workspace_id") != identity.workspace_id:
   341	            _logger.error(
   342	                json.dumps(
   343	                    {
   344	                        "event": "workspace_scope_enforced_denial",
   345	                        "record_type": "draft",
   346	                        "record_id": report_draft_id,
   347	                        "record_workspace_id": data.get("workspace_id"),
   348	                        "identity_workspace_id": identity.workspace_id,
   349	                    }
   350	                )
   351	            )
   352	            raise NotFoundError(f"report draft not found: {report_draft_id}")
   353	
   354	    # WKSP-304 Phase 4 (TASK-4.2): only ever reached once the enforcing
   355	    # branch above has already denied (and audit-logged) a cross-workspace
   356	    # mismatch, so this call is advisory-only in practice here
   357	    # (identity=None, isolation inactive, or an already-confirmed
   358	    # workspace match) — the resolver is still wired through so the
   359	    # WKSP-301 advisory WARNING path stays correct for those cases.
   360	    require_workspace_scope(
   361	        identity,
   362	        data,
   363	        record_type="draft",
   364	        record_id=report_draft_id,
   365	        resolve_enforcement=lambda: _isolation_active(paths),
   366	    )
   367	    return data
   368	
   369	
   370	def _save_draft(paths: FoundryPaths, draft: dict[str, Any]) -> dict[str, Any]:
   371	    """Persist *draft* atomically, then re-sync its derived catalog index row.
   372	
   373	    Every mutator in this module funnels through here as its last step.
   374	    """
   375	
   376	    path = _draft_yaml_path(paths, draft["report_draft_id"])
   377	    _atomic_write_yaml(draft, path)
   378	    _sync_catalog_index(paths, draft)
   379	
   380	    # Audit: single choke-point for all 11+ report-edit call-sites (fail-open).
   381	    audit_service.record_event(
   382	        paths,
   383	        AuditEvent(
   384	            mutation_type="report_edit",
   385	            action="save_draft",
   386	            target_ref=draft["report_draft_id"],
   387	            result="success",
   388	        ),
   389	    )
   390	
   391	    return draft
   392	
   393	
   394	def _touch(draft: dict[str, Any], updated_by: str | None) -> None:
   395	    draft["updated_at"] = now_iso()
   396	    if updated_by is not None:
   397	        draft["updated_by"] = updated_by
