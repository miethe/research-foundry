   514	    """
   515	    identity = getattr(request.state, "identity", None)
   516	    try:
   517	        bsvc.load_draft(paths, report_id, identity=identity)
   518	    except NotFoundError as exc:
   519	        raise _not_found(report_id) from exc
   520	    try:
   521	        return stamp(bsvc.restore_revision(paths, report_id, version_id))
   522	    except NotFoundError as exc:
