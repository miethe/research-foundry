   228	    # request.state.identity is populated when the rate limiter inspects it.
   229	    # When auth_mode=none no identity exists and the middleware passes through.
   230	    if config.auth_rate_limit_enabled():
   231	        app.add_middleware(
   232	            RateLimitMiddleware,
   233	            requests_per_window=config.auth_rate_limit_requests_per_window(),
   234	            window_seconds=config.auth_rate_limit_window_seconds(),
   235	        )

