   300	)
   301	def update_member_role(
   302	    user_id: str,
   303	    request: Request,
   304	    body: dict[str, Any] = Body(...),
   305	    paths: FoundryPaths = _PATHS_DEP,
   306	    _rbac: None = _RBAC_ADMIN,
   307	) -> dict[str, Any]:
   308	    """Update *user_id*'s role within the caller's workspace.
   309	
   310	    Request body: ``{ "role": "<role_name>" }``
   311	
   312	    ``role`` must be one of the canonical values: owner, admin, researcher,
   313	    reviewer, viewer.  Invalid values are rejected by the RBAC store FK
   314	    constraint.
   315	
   316	    Returns 404 when the user has no existing membership in this workspace.
   317	    Use ``PATCH /api/admin/workspace`` to invite new members (future P5 work).
   318	
   319	    Access: owner / admin only.
   320	
   321	    Phase 3 ACT-303: every successful update produces exactly one
   322	    ``audit_event`` row (``mutation_type="role_change"``), recorded AFTER the
   323	    mutation commits (fail-open — an audit-write failure here can never turn
   324	    a successful role update into an error response).
   325	    """
   326	    role: str = body.get("role", "")
   327	    if not role:
   328	        raise HTTPException(status_code=422, detail="'role' field is required")
   329	
   330	    workspace_id = _resolve_workspace_id(request)
   331	    try:
   332	        conn = rbac_store.bootstrap(paths)
   333	        try:
   334	            rbac_store.update_member_role(conn, user_id, workspace_id, role)
   335	        finally:
   336	            conn.close()
   337	    except KeyError:
   338	        raise HTTPException(
   339	            status_code=404,
   340	            detail=f"Member {user_id!r} not found in workspace {workspace_id!r}",
   341	        )
   342	    except Exception as exc:
   343	        logger.warning("admin: failed to update member role: %s", exc)
   344	        raise HTTPException(status_code=500, detail="Failed to update member role") from exc
   345	
   346	    identity = _get_identity(request)
   347	    audit_service.record_event(
   348	        paths,
   349	        AuditEvent(
   350	            mutation_type="role_change",
   351	            action="member_role_updated",
   352	            target_ref=user_id,
   353	            actor_user_id=identity.user_id if identity is not None else None,
   354	            actor_workspace_id=workspace_id,
   355	            result="success",
   356	        ),
   357	    )
   358	
   359	    return {"user_id": user_id, "workspace_id": workspace_id, "role": role}
   360	
   361	
   362	# ---------------------------------------------------------------------------
   363	# GET /api/admin/auth-provider-status
   364	# ---------------------------------------------------------------------------
   365	
   366	
   367	@router.get(
   368	    "/admin/auth-provider-status",
   369	    summary="Active auth provider name and availability",
   370	    tags=["admin"],
   371	)
   372	def get_auth_provider_status(
   373	    config: FoundryConfig = _CONFIG_DEP,
   374	    _rbac: None = _RBAC_ADMIN,
   375	) -> dict[str, Any]:
   376	    """Return the active auth provider name and whether it is operational.
   377	
   378	    **Security invariant**: This endpoint NEVER returns raw credentials,
   379	    JWKS secrets, Clerk secret keys, Bearer tokens, or any other private
   380	    material.  Only the provider name and a boolean availability flag are
   381	    included.
   382	
   383	    ``available`` reflects whether the registered provider's
   384	    :meth:`~research_foundry.api.auth.provider.AuthProvider.available` method
   385	    returns ``True``.  For ``provider=none`` this is always ``True`` (no-op
   386	    provider needs no external dependencies).
   387	
   388	    Access: owner / admin only.
   389	    """
   390	    try:
   391	        provider_name = config.auth_provider()
   392	    except ValueError:
   393	        # Unrecognised / unimplemented provider — report the raw value safely.
   394	        provider_name = str(config.auth.get("provider", "none"))
   395	
   396	    provider = get_provider(provider_name)
   397	    available: bool
   398	    details: Optional[str] = None
   399	
   400	    if provider is None:
   401	        # provider=none or not yet registered — always available, trivially.
   402	        available = True
   403	        if provider_name == "none":
   404	            details = "Authentication disabled (provider=none)"
   405	    else:
   406	        try:
   407	            available = provider.available()
   408	        except Exception as exc:
   409	            available = False
   410	            # Surface a non-sensitive summary only — no exception chain leakage.
   411	            details = f"Provider availability check failed: {type(exc).__name__}"
   412	
   413	    result: dict[str, Any] = {
   414	        "provider": provider_name,
   415	        "available": available,
   416	    }
   417	    if details is not None:
   418	        result["details"] = details
   419	    return result
   420	
   421	
   422	# ---------------------------------------------------------------------------
   423	# GET /api/admin/rate-limit-config
   424	# ---------------------------------------------------------------------------
   425	
   426	
   427	@router.get(
   428	    "/admin/rate-limit-config",
   429	    summary="Current rate-limit budget",
   430	    tags=["admin"],
   431	)
   432	def get_rate_limit_config(
   433	    request: Request,
   434	    config: FoundryConfig = _CONFIG_DEP,
   435	    _rbac: None = _RBAC_ADMIN,
   436	) -> dict[str, Any]:
   437	    """Return the current per-(identity, route) rate-limit budget.
   438	
   439	    Reflects any in-memory updates applied via ``PATCH /api/admin/rate-limit-config``.
   440	
   441	    ``per_identity`` and ``per_route`` are always ``true`` — they document the
   442	    keying strategy (one counter per ``(user_id, route)`` pair) rather than a
   443	    configurable option.
   444	
   445	    Access: owner / admin only.
   446	    """
   447	    return _read_rate_limit(request, config)
   448	
   449	
   450	# ---------------------------------------------------------------------------
   451	# PATCH /api/admin/rate-limit-config
   452	# ---------------------------------------------------------------------------
   453	
   454	
   455	@router.patch(
   456	    "/admin/rate-limit-config",
   457	    summary="Update rate-limit budget (in-memory, until next restart)",
   458	    tags=["admin"],
   459	)
   460	def update_rate_limit_config(
   461	    request: Request,
   462	    body: dict[str, Any] = Body(...),
   463	    config: FoundryConfig = _CONFIG_DEP,
   464	    _rbac: None = _RBAC_ADMIN,
   465	) -> dict[str, Any]:
   466	    """Apply in-memory overrides to the rate-limit budget.
   467	
   468	    Only the keys present in the body are updated; omitted keys retain their
   469	    current value.  Changes take effect for **new** requests immediately but
   470	    are not persisted to ``foundry.yaml`` — a server restart restores the
   471	    config-file defaults.
   472	
   473	    Accepted body fields:
   474	      ``max_requests``   (int)  — max requests per window per (user, route)
   475	      ``window_seconds`` (int)  — sliding window width in seconds
   476	
   477	    **Startup-only field (cannot be changed here)**:
   478	      ``enabled`` is wired into ``RateLimitMiddleware`` at startup from
   479	      ``foundry.yaml`` (``auth.rate_limit.enabled``).  The middleware reads
   480	      ``self._limiter`` only — it never consults ``app.state`` — so sending
   481	      ``enabled`` in the body has no effect on the running limiter.  Any
   482	      ``enabled`` key in the request body is silently ignored.
   483	
   484	    Returns the full updated config object on success.
   485	
   486	    Access: owner / admin only.
   487	    """
   488	    app_state = getattr(getattr(request, "app", None), "state", None)
   489	    if app_state is None:
   490	        raise HTTPException(status_code=500, detail="App state unavailable")
   491	
   492	    # Ensure overrides dict exists (should have been initialised by create_app).
   493	    if not hasattr(app_state, "rate_limit_overrides"):
   494	        app_state.rate_limit_overrides = {}
   495	
   496	    overrides: dict[str, Any] = app_state.rate_limit_overrides
   497	
   498	    # NOTE: "enabled" is intentionally not processed here.  It is a startup-only
   499	    # decision driven by foundry.yaml (auth.rate_limit.enabled) and wired into
   500	    # RateLimitMiddleware at process start.  The middleware reads self._limiter
   501	    # only; it never reads app.state, so toggling enabled here would have no
   502	    # effect.  Any "enabled" key in the request body is silently ignored.
   503	
   504	    if "max_requests" in body:
   505	        try:
   506	            val = int(body["max_requests"])
   507	        except (TypeError, ValueError) as exc:
   508	            raise HTTPException(status_code=422, detail="'max_requests' must be an integer") from exc
   509	        if val <= 0:
   510	            raise HTTPException(
   511	                status_code=422,
   512	                detail="'max_requests' must be >= 1 (same boundary as startup config)",
   513	            )
   514	        overrides["max_requests"] = val
   515	
   516	    if "window_seconds" in body:
   517	        try:
   518	            val = int(body["window_seconds"])
   519	        except (TypeError, ValueError) as exc:
   520	            raise HTTPException(status_code=422, detail="'window_seconds' must be an integer") from exc
   521	        if val <= 0:
   522	            raise HTTPException(
   523	                status_code=422,
   524	                detail="'window_seconds' must be >= 1 (same boundary as startup config)",
   525	            )
   526	        overrides["window_seconds"] = val
   527	
   528	    return _read_rate_limit(request, config)
   529	
   530	
   531	# ---------------------------------------------------------------------------
   532	# GET /api/admin/rbac-status
   533	# ---------------------------------------------------------------------------
   534	
   535	
   536	@router.get(
   537	    "/admin/rbac-status",
   538	    summary="RBAC enforcement state (read-only; any authenticated user)",
   539	    tags=["admin"],
   540	)
   541	def get_rbac_status(
   542	    request: Request,
   543	    config: FoundryConfig = _CONFIG_DEP,
   544	) -> dict[str, Any]:
   545	    """Return the current RBAC enforcement configuration.
   546	
   547	    Unlike other admin endpoints this route is accessible by **any
   548	    authenticated user** (no owner/admin gate) so that client-side code can
   549	    check whether the server is running in enforced or pass-through mode.
   550	
   551	    In single-operator mode (``auth.provider=none``, no identity on
   552	    ``request.state``) the endpoint is also accessible unconditionally.
   553	
   554	    Response shape:
   555	    ``rbac_enforcement``  (str)  — raw configured value (auto / disabled / enabled)
   556	    ``rbac_enforced``     (bool) — resolved effective state stored on app.state
   557	    ``auth_provider``     (str)  — active auth.provider value
   558	    """
   559	    # Resolved effective state (written by create_app).
   560	    app_state = getattr(getattr(request, "app", None), "state", None)
   561	    rbac_enforced: bool = bool(getattr(app_state, "rbac_enforced", False))
   562	
   563	    try:
   564	        enforcement = config.auth_rbac_enforcement()
   565	        enforcement_str = enforcement.value
   566	    except ValueError:
   567	        enforcement_str = str(config.auth.get("rbac_enforcement", "auto"))
   568	
   569	    try:
   570	        provider_name = config.auth_provider()
   571	    except ValueError:
   572	        provider_name = str(config.auth.get("provider", "none"))
   573	
   574	    return {
   575	        "rbac_enforcement": enforcement_str,
   576	        "rbac_enforced": rbac_enforced,
   577	        "auth_provider": provider_name,
   578	    }
   579	
   580	
   581	# ---------------------------------------------------------------------------
   582	# Token response helpers (Phase 3, ACT-301/ACT-302)
   583	# ---------------------------------------------------------------------------
   584	
   585	
   586	def _issued_token_response(issued: Any) -> dict[str, Any]:
   587	    """Serialize an ``IssuedToken`` for a one-time issuance response.
   588	
   589	    This is the ONLY place ``plaintext`` is ever put into a response body in
   590	    this router — every other token-shaped response goes through
   591	    :func:`_token_metadata` instead, which omits it.
   592	    """
   593	    return {
   594	        "token_id": issued.token_id,
   595	        "plaintext": issued.plaintext,
   596	        "token_prefix": issued.token_prefix,
   597	        "principal_type": issued.principal_type,
   598	        "principal_id": issued.principal_id,
   599	        "workspace_id": issued.workspace_id,
   600	        "role": issued.role,
   601	        "expires_at": issued.expires_at,
   602	    }
   603	
   604	
   605	def _token_metadata(row: dict[str, Any]) -> dict[str, Any]:
   606	    """Project an access-token row for list/get display — NEVER a secret.
   607	
   608	    *row* is one of the dicts returned by ``token_service.list_tokens`` /
   609	    ``token_service.get_token``, both of which already omit ``token_hash``
   610	    at the data layer. This helper is a second, router-level enforcement of
   611	    the same invariant, plus an explicit denylist of the plaintext key name,
   612	    so a future change to the token_service row shape cannot silently leak a
   613	    secret through this endpoint.
   614	    """
   615	    return {
   616	        "token_id": row["id"],
   617	        "principal_type": row["principal_type"],
   618	        "principal_id": row["principal_id"],
   619	        "workspace_id": row["workspace_id"],
   620	        "role": row["role"],
   621	        "token_prefix": row["token_prefix"],
   622	        "created_by": row.get("created_by"),
   623	        "created_at": row.get("created_at"),
   624	        "expires_at": row.get("expires_at"),
   625	        "revoked_at": row.get("revoked_at"),
   626	        "last_used_at": row.get("last_used_at"),
   627	    }
   628	
   629	
   630	# ---------------------------------------------------------------------------
   631	# Service accounts (Phase 3, ACT-301)
   632	# ---------------------------------------------------------------------------
   633	
   634	
   635	def _service_account_response(account: dict[str, Any]) -> dict[str, Any]:
   636	    """Project a ``service_accounts`` row for display.
   637	
   638	    Never a secret — accounts themselves never hold one; only their tokens
   639	    do (see :func:`_issued_token_response` / :func:`_token_metadata`).
   640	    """
   641	    return {
   642	        "id": account["id"],
   643	        "name": account["name"],
   644	        "workspace_id": account["workspace_id"],
   645	        "role": account["role"],
   646	        "description": account.get("description"),
   647	        "created_by": account.get("created_by"),
   648	        "created_at": account.get("created_at"),
   649	        "disabled_at": account.get("disabled_at"),
   650	    }
   651	
   652	
   653	def _get_service_account_or_404(
   654	    paths: FoundryPaths, account_id: str, workspace_id: str
   655	) -> dict[str, Any]:
   656	    """Return the ``service_accounts`` row for *account_id*, scoped to *workspace_id*.
   657	
   658	    404s uniformly for "unknown id" and "exists but in another workspace" —
   659	    the same cross-workspace-existence-hiding convention ``audit.py`` uses.
   660	    """
   661	    conn = rbac_store.bootstrap(paths)
   662	    try:
   663	        account = rbac_store.get_service_account(conn, account_id)
   664	    finally:
   665	        conn.close()
   666	    if account is None or account["workspace_id"] != workspace_id:
   667	        raise HTTPException(status_code=404, detail=f"Service account {account_id!r} not found")
   668	    return account
   669	
   670	
   671	@router.post(
   672	    "/admin/service-accounts",
   673	    status_code=201,
   674	    summary="Create a service account",
   675	    tags=["admin"],
   676	)
   677	def create_service_account(
   678	    request: Request,
   679	    body: dict[str, Any] = Body(...),
   680	    paths: FoundryPaths = _PATHS_DEP,
   681	    _rbac: None = _RBAC_ADMIN,
   682	) -> dict[str, Any]:
   683	    """Create a new service account with a single fixed role (FR-8).
   684	
   685	    Request body: ``{ "name": str, "role": str, "description"?: str }``.
   686	    Never returns a token — call ``POST .../{id}/tokens`` next to obtain one.
   687	
   688	    Access: owner / admin only.
   689	    """
   690	    name: str = str(body.get("name") or "").strip()
   691	    role: str = str(body.get("role") or "")
   692	    description: Optional[str] = body.get("description")
   693	    if not name:
   694	        raise HTTPException(status_code=422, detail="'name' field is required")
   695	    if role not in token_service.VALID_ROLES:
   696	        raise HTTPException(
   697	            status_code=422,
   698	            detail=f"'role' must be one of: {', '.join(sorted(token_service.VALID_ROLES))}",
   699	        )
   700	
   701	    workspace_id = _resolve_workspace_id(request)
   702	    identity = _get_identity(request)
   703	    account_id = f"svc_{uuid.uuid4().hex}"
   704	
   705	    conn = rbac_store.bootstrap(paths)
   706	    try:
   707	        rbac_store.create_service_account(
   708	            conn,
   709	            service_account_id=account_id,
   710	            name=name,
   711	            workspace_id=workspace_id,
   712	            role=role,
   713	            description=description,
   714	            created_by=identity.user_id if identity is not None else None,
   715	        )
   716	        account = rbac_store.get_service_account(conn, account_id)
   717	    finally:
   718	        conn.close()
   719	
   720	    audit_service.record_event(
   721	        paths,
   722	        AuditEvent(
   723	            mutation_type="principal_mutation",
   724	            action="service_account_created",
   725	            target_ref=account_id,
   726	            actor_user_id=identity.user_id if identity is not None else None,
   727	            actor_workspace_id=workspace_id,
   728	            result="success",
   729	        ),
   730	    )
   731	    if account is None:  # pragma: no cover — defensive; just created in the same call.
   732	        raise HTTPException(status_code=500, detail="Service account created but could not be re-read")
   733	    return _service_account_response(account)
   734	
   735	
   736	@router.get(
   737	    "/admin/service-accounts",
   738	    summary="List service accounts (paginated)",
   739	    tags=["admin"],
   740	)
   741	def list_service_accounts_route(
   742	    request: Request,
   743	    limit: int = Query(50, ge=1, le=200, description="Page size"),
   744	    offset: int = Query(0, ge=0, description="Number of items to skip"),
   745	    paths: FoundryPaths = _PATHS_DEP,
   746	    _rbac: None = _RBAC_ADMIN,
   747	) -> dict[str, Any]:
   748	    """List service accounts in the caller's workspace.
   749	
   750	    Access: owner / admin only.
   751	    """
   752	    workspace_id = _resolve_workspace_id(request)
   753	    conn = rbac_store.bootstrap(paths)
   754	    try:
   755	        accounts = rbac_store.list_service_accounts(conn, workspace_id=workspace_id)
   756	    finally:
   757	        conn.close()
   758	    return _paginate(
   759	        [_service_account_response(a) for a in accounts], limit=limit, offset=offset
   760	    )
   761	
   762	
   763	@router.delete(
   764	    "/admin/service-accounts/{account_id}",
   765	    summary="Disable a service account",
   766	    tags=["admin"],
   767	)
   768	def disable_service_account_route(
   769	    account_id: str,
   770	    request: Request,
   771	    paths: FoundryPaths = _PATHS_DEP,
   772	    _rbac: None = _RBAC_ADMIN,
   773	) -> dict[str, Any]:
   774	    """Disable *account_id* (idempotent).
   775	
   776	    Disabling does not itself revoke previously-issued tokens as a separate
   777	    step — ``token_service.verify_token`` independently checks
   778	    ``disabled_at`` at every resolution, so the practical effect is
   779	    immediate regardless (see ``rbac_store.disable_service_account``).
   780	
   781	    404 when unknown or in another workspace.
   782	
   783	    Access: owner / admin only.
   784	    """
   785	    workspace_id = _resolve_workspace_id(request)
   786	    _get_service_account_or_404(paths, account_id, workspace_id)
   787	
   788	    conn = rbac_store.bootstrap(paths)
   789	    try:
   790	        rbac_store.disable_service_account(conn, account_id)
   791	    finally:
   792	        conn.close()
   793	
   794	    identity = _get_identity(request)
   795	    audit_service.record_event(
   796	        paths,
   797	        AuditEvent(
   798	            mutation_type="principal_mutation",
   799	            action="service_account_disabled",
   800	            target_ref=account_id,
   801	            actor_user_id=identity.user_id if identity is not None else None,
   802	            actor_workspace_id=workspace_id,
   803	            result="success",
   804	        ),
   805	    )
   806	    return {"id": account_id, "disabled": True}
   807	
   808	
   809	@router.post(
   810	    "/admin/service-accounts/{account_id}/tokens",
   811	    status_code=201,
   812	    summary="Issue (or rotate) a service account's access token",
   813	    tags=["admin"],
   814	)
   815	def issue_service_account_token_route(
   816	    account_id: str,
   817	    request: Request,
   818	    body: dict[str, Any] = Body(default={}),
   819	    paths: FoundryPaths = _PATHS_DEP,
   820	    _rbac: None = _RBAC_ADMIN,
   821	) -> dict[str, Any]:
   822	    """Issue a fresh access token for *account_id*, rotating out any prior
   823	    active token for it first (FR-8; rotate-on-issue — a service account
   824	    never has more than one live token).
   825	
   826	    Request body: ``{ "expires_at"?: str }`` (both optional; may be omitted).
   827	
   828	    **``plaintext`` in the response is shown here ONLY** — it is never
   829	    persisted, logged, or returned by any other route in this router.
   830	
   831	    404 when *account_id* is unknown or in another workspace.
   832	
   833	    Access: owner / admin only.
   834	    """
   835	    workspace_id = _resolve_workspace_id(request)
   836	    _get_service_account_or_404(paths, account_id, workspace_id)
   837	
   838	    identity = _get_identity(request)
   839	    try:
   840	        issued = token_service.rotate_service_account_token(
   841	            paths,
   842	            service_account_id=account_id,
   843	            created_by=identity.user_id if identity is not None else None,
   844	            expires_at=body.get("expires_at"),
   845	        )
   846	    except TokenServiceError as exc:
   847	        # The only way to reach here after the existence check above is a
   848	        # disabled account (a race with a concurrent disable) — 409
   849	        # Conflict, not 404 (we already KNOW the account exists).
   850	        raise HTTPException(status_code=409, detail=str(exc)) from exc
   851	
   852	    audit_service.record_event(
   853	        paths,
   854	        AuditEvent(
   855	            mutation_type="access_token_issued",
   856	            action="service_account_token_rotated",
   857	            target_ref=issued.token_id,
   858	            actor_user_id=identity.user_id if identity is not None else None,
   859	            actor_workspace_id=workspace_id,
   860	            result="success",
   861	        ),
   862	    )
   863	    return _issued_token_response(issued)
   864	
   865	
   866	@router.get(
   867	    "/admin/service-accounts/{account_id}/tokens",
   868	    summary="List a service account's tokens (paginated, no secrets)",
   869	    tags=["admin"],
   870	)
   871	def list_service_account_tokens_route(
   872	    account_id: str,
   873	    request: Request,
   874	    limit: int = Query(50, ge=1, le=200, description="Page size"),
