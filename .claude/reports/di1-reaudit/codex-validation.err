   924	# ---------------------------------------------------------------------------
   925	# Create-from-* helpers (spec §8: template / run / collection / blank)
   926	# ---------------------------------------------------------------------------
   927	
   928	_RAW_MD = MarkdownIt("commonmark")
   929	_RAW_CONTAINER_OPEN = frozenset(
   930	    {"blockquote_open", "bullet_list_open", "ordered_list_open", "list_item_open"}
   931	)
   932	_RAW_CONTAINER_CLOSE = frozenset(
   933	    {"blockquote_close", "bullet_list_close", "ordered_list_close", "list_item_close"}
   934	)
   935	
   936	
   937	def _extract_raw_blocks(report_draft_md: str) -> list[dict[str, str]]:
   938	    """Ordered top-level heading/paragraph text from *report_draft_md*.
   939	
   940	    Mirrors ``export_service.derive_report_anchors()``'s token walk (same
   941	    container-exclusion + h2/h3-only heading rule) purely to recover each
   942	    block's editable raw text — ``report_anchors`` itself carries no prose
   943	    (see that function's docstring), so this positional walk is how the
   944	    Builder gets human-editable text that lines up 1:1, in document order,
   945	    with the paragraph anchors already computed by the export layer.
   946	    """
   947	
   948	    if not report_draft_md:
   949	        return []
   950	    tokens = _RAW_MD.parse(report_draft_md)
   951	    n = len(tokens)
   952	    blocks: list[dict[str, str]] = []
   953	    container_depth = 0
   954	    i = 0
   955	    while i < n:
   956	        tok = tokens[i]
   957	        if tok.type in _RAW_CONTAINER_OPEN:
   958	            container_depth += 1
   959	            i += 1
   960	            continue
   961	        if tok.type in _RAW_CONTAINER_CLOSE:
   962	            container_depth -= 1
   963	            i += 1
   964	            continue
   965	        if tok.type == "heading_open":
   966	            next_tok = tokens[i + 1] if i + 1 < n else None
   967	            has_inline = next_tok is not None and next_tok.type == "inline"
   968	            if container_depth == 0 and has_inline and next_tok is not None:
   969	                tag_level = tok.tag[1:]
   970	                level = int(tag_level) if tag_level.isdigit() else None
   971	                if level in (2, 3):
   972	                    blocks.append({"kind": "heading", "text": next_tok.content})
   973	            i += 3 if has_inline else 1
   974	            continue
   975	        if tok.type == "paragraph_open":
   976	            next_tok = tokens[i + 1] if i + 1 < n else None
   977	            has_inline = next_tok is not None and next_tok.type == "inline"
   978	            if container_depth == 0 and has_inline and next_tok is not None:
   979	                normalized = _normalize_text(next_tok.content)
   980	                if normalized:
   981	                    blocks.append({"kind": "paragraph", "text": normalized})
   982	            i += 3 if has_inline else 1
   983	            continue
   984	        i += 1
   985	    return blocks
   986	
