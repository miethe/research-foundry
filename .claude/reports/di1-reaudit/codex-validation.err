   958	def issue_pat(
   959	    request: Request,
   960	    body: dict[str, Any] = Body(...),
   961	    paths: FoundryPaths = _PATHS_DEP,
   962	) -> dict[str, Any]:
   963	    """Issue a PAT.
   964	
   965	    Request body: ``{ "role": str, "expires_at"?: str, "user_id"?: str }``.
   966	
