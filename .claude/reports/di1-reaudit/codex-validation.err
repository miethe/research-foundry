   314	@router.get("/reports", summary="List report drafts")
   315	def list_drafts(
   316	    request: Request,
   317	    sensitivity_threshold: str | None = Query(
   318	        None,
   319	        description="Override foundry.yaml viewer.sensitivity_threshold (default: public).",
   320	    ),
   321	    paths: FoundryPaths = _PATHS_DEP,
   322	) -> list[dict[str, Any]]:
   323	    """Return summary rows for on-disk drafts visible at the resolved
   324	    sensitivity threshold.  Fail-closed (R2 fix): a draft whose sensitivity
   325	    rank exceeds the threshold — including one with an unrecognized label —
   326	    is silently omitted, mirroring ``catalog_service.search``'s gating.
   327	    Empty/fully-gated corpus → ``[]``.
   328	    """
   329	    identity = getattr(request.state, "identity", None)
   330	    threshold_rank = _resolve_threshold_rank(paths, sensitivity_threshold, request)
   331	    return [
   332	        d
   333	        for d in bsvc.list_drafts(paths, identity=identity)
   334	        if _sensitivity_rank(d.get("sensitivity")) <= threshold_rank
   335	    ]
   336	
