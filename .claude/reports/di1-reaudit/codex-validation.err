   189	def _hash_token(full_token: str, token_prefix: str) -> str:
   190	    """Return the persisted hash for *full_token* (FR-7's "salted hash").
   191	
   192	    Uses HMAC-SHA256 keyed by the token's OWN non-secret prefix over the
   193	    remainder of the token.  This is a deliberate salt-free design: the
   194	    pre-image (``full_token``) is freshly generated per-token by a CSPRNG
   195	    with >= 256 bits of entropy (see ``_generate_secret``), so there is no
   196	    low-entropy-guessing threat a traditional per-row salt column defends
   197	    against (unlike a human-chosen password).  Keying the HMAC by the
   198	    prefix still gives domain separation from a bare
   199	    ``sha256(secret)`` digest at zero schema cost -- no separate salt
   200	    column is needed in ``access_tokens`` (see rbac_store's access_tokens
   201	    DDL comment, OQ-2 area).
   202	    """
   203	    remainder = full_token[len(token_prefix):]
