     1	"""Audit service for Research Foundry (public-multiuser-release Phase 5, AUDIT-001).
     2	
     3	Provides an append-only audit log stored in the durable ``.rf_state/rbac.db``
     4	database (same store as the RBAC membership tables).  Every governed mutation --
     5	catalog import, report edit, agent-job launch (reserved, N/A until P4), artifact
     6	ingest, publish-preview, and writeback -- produces a queryable row capturing who
     7	did what, from which source, and under which policy snapshot.
     8	
     9	FAIL-OPEN INVARIANT
    10	-------------------
    11	``record_event`` is the sole write entrypoint.  It wraps its SQLite write in a
    12	broad ``try/except`` that NEVER raises outward.  On failure it emits a
    13	structured ``logging.ERROR`` (never a silent ``pass``) and optionally an OTel
    14	span with ``status=ERROR``.  The caller is therefore safe to call this function
    15	after its own mutation commit without risking a rollback or a changed HTTP
    16	status -- a lost audit row is loud but non-blocking.
    17	
    18	This is distinct from RBAC's fail-closed contract (P5.2): authorization gates
    19	are evaluated *before* a mutation and must deny the request on any unresolved
    20	identity.  Fail-open applies only to the audit side-channel; fail-closed applies
    21	only to the authorization gate.  Never conflate the two.
    22	
    23	APPEND-ONLY CONTRACT
    24	--------------------
    25	The ``audit_event`` table has no UPDATE or DELETE paths.  Rows are immutable.
    26	Do not add UPDATE/DELETE helpers to this module.
    27	"""
    28	
    29	from __future__ import annotations
    30	
    31	import dataclasses
    32	import json
    33	import logging
    34	import sqlite3
    35	import uuid
    36	from datetime import datetime, timezone
    37	from typing import Any, Optional
    38	
    39	from research_foundry.api.auth.provider import AuthIdentity
    40	from research_foundry.api.auth.scope import resolve_workspace_isolation_active
    41	from research_foundry.paths import FoundryPaths
    42	from research_foundry.services.rbac_store import _connect, _ensure_schema
    43	
    44	log = logging.getLogger(__name__)
    45	
    46	
    47	def _isolation_active(paths: FoundryPaths) -> bool:
    48	    """Resolve whether WKSP-304 workspace isolation is actively enforced.
    49	
    50	    Thin delegate to the single shared implementation
    51	    (:func:`research_foundry.api.auth.scope.resolve_workspace_isolation_active`)
    52	    that ``catalog_service.py``/``builder_service.py``/``AgentJobService``
    53	    already use — see that module's docstring. Kept as a module-local
    54	    wrapper only for call-site symmetry with those modules (DI-1 full-surface
    55	    audit, Phase 4 ACT-401).
    56	    """
    57	
    58	    return resolve_workspace_isolation_active(paths)
    59	
    60	# ---------------------------------------------------------------------------
    61	# Health state dataclass (AUDIT-004)
    62	# ---------------------------------------------------------------------------
    63	
    64	
    65	@dataclasses.dataclass(frozen=True)
    66	class AuditHealth:
    67	    """Immutable snapshot of the audit-store health state.
    68	
    69	    ``last_probe_at`` is ``None`` only when ``get_health_state`` is called
    70	    before the first ``health_check`` probe has ever run (i.e., no row in
    71	    the ``audit_health`` table yet).
    72	    """
    73	
    74	    healthy: bool
    75	    last_probe_at: Optional[str]    # ISO-8601 UTC; None = never probed
    76	    last_success_at: Optional[str]  # None if never succeeded
    77	    error_detail: Optional[str]     # populated when healthy=False
    78	
    79	# ---------------------------------------------------------------------------
    80	# Mutation-type taxonomy (all 6 reserved; 5 wired in P5.5)
    81	# ---------------------------------------------------------------------------
    82	
    83	MUTATION_TYPES: frozenset[str] = frozenset(
    84	    {
    85	        "catalog_mutation",
    86	        "report_edit",
    87	        "agent_job_launched",  # Wired ACT-204 (multi_user identity binding only)
    88	        "artifact_accepted",
    89	        "publish_preview",
    90	        "writeback",
    91	        # Wired public-multiuser-release-activation Phase 3 (ACT-303) — admin
    92	        # API mutations over principals, access tokens, and role assignments.
    93	        "principal_mutation",   # service-account create/disable
    94	        "access_token_issued",  # PAT issuance, service-account token issue/rotate
    95	        "access_token_revoked",  # PAT revoke, service-account token revoke
    96	        "role_change",           # workspace member role update
    97	    }
    98	)
