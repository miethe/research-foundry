     1	"""GET /auth/identity — caller's own identity endpoint (P5.4 FU-2).
     2	
     3	Route: GET /auth/identity  (mounted under /api in create_app → /api/auth/identity)
     4	
     5	Three-mode behaviour
     6	--------------------
     7	1. ``auth.provider=none`` (no auth middleware installed):
     8	   ``request.state`` never gains an ``identity`` attribute; the route handler
     9	   returns an anonymous/null response.  The frontend (useClerkAuth.ts) only
    10	   invokes this endpoint when ``auth.provider=clerk`` is active, so this branch
    11	   is the graceful degradation path for single-operator / no-auth deployments.
    12	
    13	   JSON: ``{"user_id": null, "workspace_id": null, "roles": []}``
    14	
    15	2. ``auth.provider=clerk`` or ``auth.provider=local_static`` — request
    16	   unauthenticated (no valid token):
    17	   :class:`~research_foundry.api.middleware.auth.AuthProviderMiddleware`
    18	   intercepts the request and returns HTTP 401 **before this route runs**.
    19	   The route handler is never reached.
    20	
    21	3. ``auth.provider=clerk`` or ``auth.provider=local_static`` — request
    22	   authenticated (valid token):
    23	   The middleware sets ``request.state.identity`` and forwards the request.
    24	   The route handler returns the caller's own identity.
    25	
    26	   JSON: ``{"user_id": str, "workspace_id": str, "roles": [str, ...]}``
    27	
    28	Security notes
    29	--------------
    30	* Only the **caller's own** identity is returned — there is no ``user_id``
    31	  query parameter and no admin RBAC gate.  A caller can only inspect their
    32	  own resolved identity.
    33	* No raw token content, JWKS material, or provider name is included in any
    34	  response body.
    35	"""
    36	
    37	from __future__ import annotations
    38	
    39	from fastapi import APIRouter
    40	from starlette.requests import Request
    41	
    42	from ..auth.provider import AuthIdentity
    43	
    44	router = APIRouter()
    45	
    46	
    47	@router.get("/auth/identity", tags=["auth"])
    48	def get_auth_identity(request: Request) -> dict:
    49	    """Return the current request's resolved :class:`~AuthIdentity`.
    50	
    51	    The response shape matches the FE ``AuthIdentity`` interface in
    52	    ``useClerkAuth.ts`` exactly:
    53	
    54	    .. code-block:: json
    55	
    56	        {"user_id": "string", "workspace_id": "string", "roles": ["string"]}
    57	
    58	    In ``auth.provider=none`` mode every field is ``null`` / ``[]``:
    59	
    60	    .. code-block:: json
    61	
    62	        {"user_id": null, "workspace_id": null, "roles": []}
    63	
    64	    Returns:
    65	        A JSON dict with ``user_id`` (str | None), ``workspace_id``
    66	        (str | None), and ``roles`` (list[str]).  HTTP 401 is returned
    67	        by the upstream middleware before this handler runs when auth is
    68	        enabled and the request carries no valid credential.
    69	    """
    70	    identity: AuthIdentity | None = getattr(request.state, "identity", None)
    71	    if identity is None:
    72	        # auth.provider=none — no auth middleware; anonymous single-operator mode.
    73	        return {"user_id": None, "workspace_id": None, "roles": []}
    74	    return {
    75	        "user_id": identity.user_id,
    76	        "workspace_id": identity.workspace_id,
    77	        "roles": list(identity.roles),
    78	    }
    79	
    80	
    81	__all__ = ["router"]

