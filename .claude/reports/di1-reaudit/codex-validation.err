   234	        Retry-After: <int>             # seconds until window resets (ceil ≥ 1)
   235	        X-RateLimit-Limit: <int>       # configured maximum requests per window
   236	        X-RateLimit-Remaining: 0
   237	        X-RateLimit-Reset: <int>
   238	
