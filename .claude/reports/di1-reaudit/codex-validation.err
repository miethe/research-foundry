   815	def issue_service_account_token_route(
   816	    account_id: str,
   817	    request: Request,
   818	    body: dict[str, Any] = Body(default={}),
   819	    paths: FoundryPaths = _PATHS_DEP,
   820	    _rbac: None = _RBAC_ADMIN,
   821	) -> dict[str, Any]:
   822	    """Issue a fresh access token for *account_id*, rotating out any prior
   823	    active token for it first (FR-8; rotate-on-issue — a service account
