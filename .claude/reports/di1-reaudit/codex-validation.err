   183	def _generate_secret() -> tuple[str, str]:
   184	    """Generate a fresh opaque token.  Returns ``(full_token, token_prefix)``."""
   185	    full_token = secrets.token_urlsafe(_TOKEN_ENTROPY_BYTES)
