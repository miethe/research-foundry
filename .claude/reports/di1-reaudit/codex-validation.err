   275	# ---------------------------------------------------------------------------
   276	# Read entrypoints
   277	# ---------------------------------------------------------------------------
   278	
   279	
   280	def list_events(
   281	    paths: FoundryPaths,
   282	    *,
   283	    mutation_type: Optional[str] = None,
   284	    actor_user_id: Optional[str] = None,
   285	    workspace_id: Optional[str] = None,
   286	    since: Optional[str] = None,
   287	    until: Optional[str] = None,
   288	    limit: int = 50,
   289	    cursor: Optional[str] = None,
   290	    identity: Optional[AuthIdentity] = None,
   291	) -> dict[str, Any]:
   292	    """Return a cursor-paginated list of audit events.
   293	
   294	    Results are ordered most-recent-first (descending ``created_at``).
   295	
   296	    The ``cursor`` is the last ``audit_event_id`` seen in a previous page.
   297	    Pass it to receive the next page.  Pass ``None`` (or omit) to start from
   298	    the most recent event.
   299	
   300	    Returns a dict with keys ``items``, ``next_cursor``, and ``total_hint``.
   301	    Each item dict matches the ``audit_event`` table columns exactly.
   302	    ``policy_snapshot`` is returned as a parsed ``dict`` (or ``None``).
   303	
   304	    ``identity`` is DI-1 full-surface audit scoping (Phase 4 ACT-401): the
   305	    ``RBAC-006`` ``owner``/``admin`` gate on this endpoint is
   306	    **workspace-scoped** (``AuthIdentity.roles`` is granted "within the
   307	    workspace" — see ``api/auth/provider.py``), so without this the
   308	    caller-supplied ``workspace_id`` filter let an owner/admin of workspace A
   309	    read workspace B's audit trail (actor IDs, policy snapshots) simply by
   310	    passing ``?workspace=B`` — or read *every* workspace's events at once by
   311	    omitting the filter entirely. When ``identity`` is not ``None`` and
   312	    isolation is actively enforced, the caller's own ``identity.workspace_id``
   313	    always wins over any client-supplied ``workspace_id`` argument — mirrors
   314	    the "identity overrides client input" idiom used by
   315	    ``builder_service.create_draft``/``admin.py``'s ``_resolve_workspace_id``.
   316	    ``identity=None`` (the default) or isolation inactive is byte-identical
   317	    to the pre-Phase-4 behavior (FR-2 regression guarantee) — every existing
   318	    caller that omits ``identity`` is unaffected.
   319	    """
   320	    effective_workspace_id = workspace_id
   321	    if identity is not None and _isolation_active(paths):
   322	        effective_workspace_id = identity.workspace_id
   323	    workspace_id = effective_workspace_id
   324	
   325	    conn = _connect(paths)
   326	    try:
   327	        _ensure_schema(conn)
   328	        conn.row_factory = sqlite3.Row
   329	
   330	        clauses: list[str] = []
   331	        params: list[Any] = []
   332	
   333	        if mutation_type is not None:
   334	            clauses.append("mutation_type = ?")
   335	            params.append(mutation_type)
   336	        if actor_user_id is not None:
   337	            clauses.append("actor_user_id = ?")
   338	            params.append(actor_user_id)
   339	        if workspace_id is not None:
   340	            clauses.append("actor_workspace_id = ?")
   341	            params.append(workspace_id)
   342	        if since is not None:
   343	            clauses.append("created_at >= ?")
   344	            params.append(since)
   345	        if until is not None:
   346	            clauses.append("created_at <= ?")
   347	            params.append(until)
   348	
   349	        # Cursor pagination: find events older than (or equal to) the cursor's
   350	        # created_at, excluding the cursor row itself.
   351	        if cursor is not None:
   352	            row = conn.execute(
   353	                "SELECT created_at FROM audit_event WHERE audit_event_id = ?",
   354	                (cursor,),
   355	            ).fetchone()
   356	            if row is not None:
   357	                clauses.append(
   358	                    "(created_at < ? OR (created_at = ? AND audit_event_id < ?))"
   359	                )
   360	                params.extend([row["created_at"], row["created_at"], cursor])
   361	
   362	        where = ("WHERE " + " AND ".join(clauses)) if clauses else ""
   363	
   364	        # Fetch limit+1 to detect whether a next page exists.
   365	        rows = conn.execute(
   366	            "SELECT * FROM audit_event "
   367	            + where
   368	            + " ORDER BY created_at DESC, audit_event_id DESC"
   369	            + " LIMIT ?",
   370	            params + [limit + 1],
   371	        ).fetchall()
   372	
   373	        has_more = len(rows) > limit
   374	        page = rows[:limit]
   375	
   376	        items = [_row_to_dict(r) for r in page]
   377	        next_cursor = page[-1]["audit_event_id"] if has_more and page else None
   378	
   379	        return {
   380	            "items": items,
   381	            "next_cursor": next_cursor,
   382	            "total_hint": None,  # Expensive COUNT(*) omitted; use cursor pagination
   383	        }
   384	    finally:
   385	        conn.close()
   386	
   387	
   388	def get_event(
   389	    paths: FoundryPaths,
   390	    audit_event_id: str,
   391	    *,
   392	    identity: Optional[AuthIdentity] = None,
   393	) -> Optional[dict[str, Any]]:
   394	    """Return a single audit event by ID, or ``None`` if not found.
   395	
   396	    The caller (router) is responsible for mapping ``None`` to a 404 response.
   397	
   398	    ``identity`` is DI-1 full-surface audit scoping (Phase 4 ACT-401): this
   399	    lookup previously had **no** workspace check at all, so any owner/admin
   400	    (a workspace-scoped role — see :func:`list_events`) could read any other
   401	    workspace's audit event by ID. When ``identity`` is not ``None`` and
   402	    isolation is actively enforced, a row whose ``actor_workspace_id`` does
   403	    not match ``identity.workspace_id`` is treated exactly like a missing
   404	    event (``None``) — the same fail-closed, indistinguishable-404 contract
   405	    every other cross-workspace read in this codebase uses (e.g.
   406	    ``catalog_service.get_item``, ``builder_service.load_draft``).
   407	    ``identity=None`` (the default) or isolation inactive is byte-identical
   408	    to the pre-Phase-4 behavior.
   409	    """
   410	    conn = _connect(paths)
   411	    try:
   412	        _ensure_schema(conn)
   413	        conn.row_factory = sqlite3.Row
   414	        row = conn.execute(
   415	            "SELECT * FROM audit_event WHERE audit_event_id = ?",
   416	            (audit_event_id,),
   417	        ).fetchone()
   418	        if row is None:
   419	            return None
   420	        result = _row_to_dict(row)
   421	        if identity is not None and _isolation_active(paths):
   422	            if result.get("actor_workspace_id") != identity.workspace_id:
   423	                log.error(
   424	                    json.dumps(
   425	                        {
   426	                            "event": "workspace_scope_enforced_denial",
   427	                            "record_type": "audit_event",
   428	                            "record_id": audit_event_id,
   429	                            "record_workspace_id": result.get("actor_workspace_id"),
   430	                            "identity_workspace_id": identity.workspace_id,
   431	                        }
   432	                    )
   433	                )
   434	                return None
   435	        return result
   436	    finally:
   437	        conn.close()
   438	
   439	
   440	# ---------------------------------------------------------------------------
   441	# Row serialisation helper
   442	# ---------------------------------------------------------------------------
   443	
   444	
   445	def _row_to_dict(row: sqlite3.Row) -> dict[str, Any]:
   446	    """Convert a ``sqlite3.Row`` to a plain ``dict``.
   447	
   448	    ``policy_snapshot`` is JSON-decoded when present.
   449	    """
   450	    d = dict(row)
   451	    if d.get("policy_snapshot") is not None:
   452	        try:
   453	            d["policy_snapshot"] = json.loads(d["policy_snapshot"])
   454	        except (json.JSONDecodeError, TypeError):
   455	            pass  # Return the raw string rather than crashing
   456	    return d
   457	
   458	
   459	# ---------------------------------------------------------------------------
   460	# Audit-store health check (AUDIT-004)
   461	# ---------------------------------------------------------------------------
   462	
   463	
   464	def _run_probe(conn: sqlite3.Connection, probe_id: str, now: str) -> None:
   465	    """Write-then-read round-trip probe against ``audit_event``.
   466	
   467	    Inserts a row with the given ``probe_id``, reads it back, then deletes
   468	    it.  Raises on any failure.  The probe row is ephemeral and is never
   469	    surfaced through ``list_events`` or ``get_event``.
   470	
   471	    INVARIANT: this function may be monkeypatched in tests to simulate
   472	    a probe failure without affecting the rest of ``health_check``.
   473	    """
   474	    conn.execute(
   475	        (
   476	            "INSERT INTO audit_event ("
   477	            "    audit_event_id, created_at, mutation_type, action, target_ref, result"
   478	            ") VALUES (?, ?, ?, ?, ?, ?)"
   479	        ),
   480	        (probe_id, now, "catalog_mutation", "_health_probe", "_health_probe", "success"),
   481	    )
   482	    row = conn.execute(
   483	        "SELECT audit_event_id FROM audit_event WHERE audit_event_id = ?",
   484	        (probe_id,),
   485	    ).fetchone()
   486	    if row is None:
   487	        raise RuntimeError("health probe row not found after write — store may be read-only")
   488	    conn.execute(
   489	        "DELETE FROM audit_event WHERE audit_event_id = ?",
   490	        (probe_id,),
   491	    )
   492	
   493	
   494	def health_check(paths: FoundryPaths) -> AuditHealth:
   495	    """Run a write-then-read probe and persist the result in ``audit_health``.
   496	
   497	    Returns an :class:`AuditHealth` with ``healthy=True`` on success or
   498	    ``healthy=False`` (with ``error_detail`` populated) on any failure.
   499	
   500	    CRITICAL INVARIANTS
   501	    -------------------
   502	    - NEVER calls ``record_event()`` — the probe row is ephemeral and must
   503	      NOT appear in the audit log returned by ``list_events()``.
   504	    - ``is_healthy_for_exposure()`` MUST NOT be called from this function
   505	      or any mutation call-site — it is reserved for the P5.6 exposure gate.
   506	    """
   507	    now = datetime.now(tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%S") + "Z"
   508	    probe_id = f"_probe_{uuid.uuid4()}"
   509	
   510	    try:
   511	        conn = _connect(paths)
   512	        try:
   513	            _ensure_schema(conn)
   514	
   515	            # Capture prior last_success_at before the probe so failure
   516	            # reporting can preserve the last-known-good timestamp.
   517	            prior_row = conn.execute(
   518	                "SELECT last_success_at FROM audit_health WHERE id = 1"
   519	            ).fetchone()
   520	            prior_success_at: Optional[str] = prior_row["last_success_at"] if prior_row else None

