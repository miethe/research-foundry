   238	        "enabled": config.auth_rate_limit_enabled(),
   239	        "window_seconds": overrides.get(
   240	            "window_seconds", config.auth_rate_limit_window_seconds()
   241	        ),
   242	        "max_requests": overrides.get(
   243	            "max_requests", config.auth_rate_limit_requests_per_window()
   244	        ),
   245	        "per_identity": True,
   246	        "per_route": True,
   247	    }
