  1161	    def deployment_mode_validate(self, *, bind_host: str | None = None) -> None:
  1162	        """Fail-closed startup gate for ``deployment_mode=multi_user`` (FR-4).
  1163	
  1164	        **Full 4-condition suite** (Phase 4 ACT-402 completes the P1 stub,
  1165	        which evaluated only (a)-(c)) — see Phase 4 AC-3.
  1166	
  1167	        No-op when :meth:`deployment_mode` resolves to ``"single_user"`` (the
  1168	        default) — this gate only ever constrains ``multi_user`` deployments,
  1169	        so it can never regress single-user/LAN behaviour.
  1170	
  1171	        Conditions checked (multi_user only)
  1172	        -------------------------------------
  1173	        (a) ``auth.provider`` must not be ``"none"``.
  1174	        (b) ``auth.rbac_enforcement`` must resolve to enforced
  1175	            (:meth:`resolve_rbac_enforced`).
  1176	        (c) ``workspace_isolation_enforcement`` must resolve to enforced
  1177	            (:meth:`resolve_workspace_isolation_enforced`).
  1178	        (d) **DI-1 full-surface audit two-part gate** (FR-13, Phase 4
  1179	            ACT-401/ACT-402): BOTH halves must independently hold —
  1180	            :meth:`di1_audit_acknowledged` (``auth.di1_audit_acknowledged``
  1181	            resolves ``True``) AND :meth:`_di1_audit_accepted` (the audit
  1182	            artifact at :meth:`_di1_audit_report_path` exists and its
  1183	            frontmatter ``status`` is literally ``"accepted"``). Neither a
  1184	            stale/never-updated doc with the ack flag flipped, nor an
  1185	            accepted doc with the ack flag never set, satisfies this
  1186	            condition alone — both are named independently in the raised
  1187	            error when either is missing. A missing artifact file is
  1188	            treated identically to an unaccepted one (never "assume
  1189	            passed"). No agent may set the artifact's ``status`` to
  1190	            ``"accepted"`` itself (Mode D, ACT-406) — this method only
  1191	            *reads* that field, it never writes it.
  1192	
  1193	        Parameters
  1194	        ----------
  1195	        bind_host:
  1196	            The effective ``viewer.bind_host`` value, forwarded to
  1197	            :meth:`resolve_rbac_enforced` / :meth:`resolve_workspace_isolation_enforced`
  1198	            for their own fail-closed loopback checks. Defaults to
  1199	            :meth:`viewer_bind_host` when omitted.
  1200	
  1201	        Raises
  1202	        ------
  1203	        ValueError
  1204	            Naming EVERY unmet condition (not just the first) when
  1205	            ``deployment_mode=multi_user`` and one or more of (a)-(d) fail.
  1206	            The server/app **must not start** in this state.
  1207	        """
  1208	        mode = self.deployment_mode()
  1209	        if mode != "multi_user":
  1210	            return
  1211	
