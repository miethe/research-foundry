   707	def add_claim_link(
   708	    paths: FoundryPaths,
   709	    report_draft_id: str,
   710	    *,
   711	    block_id: str,
   712	    claim_id: str,
   713	    relation: str | None = None,
   714	    source_run_id: str | None = None,
