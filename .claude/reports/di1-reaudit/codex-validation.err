  1674	    """Return the full detail for *catalog_item_id*, or ``None`` if unknown or
  1675	
  1676	    excluded by the resolved sensitivity threshold (fail-closed — callers
  1677	    should translate ``None`` to a 404, never distinguishing "doesn't exist"
  1678	    from "not visible").
  1679	
  1680	    ``identity`` is WKSP-304 Phase 3 query-layer scoping (see module
  1681	    docstring): ``None`` (the default) is byte-identical to the pre-WKSP-304
  1682	    query for every statement below, including the outgoing/incoming link
  1683	    joins and the citing-drafts join (AC-4 — the predicate is applied to the
  1684	    joined side, not only the primary ``catalog_items`` row, so a cross-
  1685	    workspace link target can't leak through an edge even once isolation is
  1686	    active).
  1687	
  1688	    WKSP-304 Phase 4 (TASK-4.2): the primary row's scoped ``WHERE
  1689	    workspace_id = ?`` predicate below is the query-layer deny mechanism for
  1690	    this single-record read (same idiom as the list-oriented ``search()``);
  1691	    a cross-workspace lookup returns no row and is audit-logged (distinct
  1692	    from the advisory ``WARNING``) via
  1693	    :func:`_log_enforced_denial_if_exists_elsewhere`, then 404s exactly like
  1694	    a genuinely-missing item (OQ-1 — silent either way).
  1695	    """
  1696	
  1697	    threshold_rank = _rank(resolve_threshold(paths, sensitivity_threshold))
  1698	    workspace_scoped = identity is not None and _isolation_active(paths)
  1699	    workspace_id = identity.workspace_id if workspace_scoped else None  # type: ignore[union-attr]
  1700	
  1701	    with _db(paths) as conn:
  1702	        if workspace_id is not None:
  1703	            row = conn.execute(
  1704	                "SELECT * FROM catalog_items WHERE catalog_item_id = ? AND workspace_id = ?",
  1705	                (catalog_item_id, workspace_id),
  1706	            ).fetchone()
  1707	            if row is None:
  1708	                _log_enforced_denial_if_exists_elsewhere(
  1709	                    conn, identity, record_type="catalog_item", record_id=catalog_item_id
  1710	                )
  1711	                return None
  1712	        else:
  1713	            row = conn.execute(
  1714	                "SELECT * FROM catalog_items WHERE catalog_item_id = ?", (catalog_item_id,)
  1715	            ).fetchone()
  1716	            if row is None:
  1717	                return None
  1718	        if row["sensitivity_rank"] > threshold_rank:
  1719	            return None
