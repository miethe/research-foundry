   187	            sensitivity_threshold=sensitivity_threshold,
   188	            evidence_plan=evidence_plan,
   189	        )
   190	
   191	    @server.tool()
   192	    def search_source_discovery(
   193	        request: dict[str, Any],
   194	        identity: dict[str, Any] | None = None,
   195	        sensitivity_threshold: str | None = None,
   196	        evidence_plan: dict[str, Any] | None = None,
   197	    ) -> dict[str, Any]:
   198	        """Run a search with ``mode="source_discovery"`` (Brave → Exa)."""
   199	        return _run_search_with_context(
   200	            _with_mode(request, "source_discovery"), identity, sensitivity_threshold, evidence_plan
   201	        )
   202	
   203	    @server.tool()
