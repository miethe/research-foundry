  1123	    token_service.revoke_token(paths, token_id)
  1124	
  1125	    audit_service.record_event(
  1126	        paths,
  1127	        AuditEvent(
  1128	            mutation_type="access_token_revoked",
  1129	            action="pat_revoked",
  1130	            target_ref=token_id,
  1131	            actor_user_id=identity.user_id if identity is not None else None,
  1132	            actor_workspace_id=token["workspace_id"],
  1133	            result="success",
