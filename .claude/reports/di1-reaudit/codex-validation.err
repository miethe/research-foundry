   568	    retrieval_block: dict[str, Any] = request.get("retrieval") or {}
   569	    retrieval_policy = str(retrieval_block.get("policy") or "disabled")
   570	    if retrieval_policy not in _ACTIVE_RETRIEVAL_POLICIES:
