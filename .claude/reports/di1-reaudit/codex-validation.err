   500	def run_search(
   501	    request: dict[str, Any],
   502	    *,
   503	    paths: FoundryPaths | None = None,
   504	    providers: dict[str, SearchProvider] | None = None,
   505	    identity: AuthIdentity | None = None,
   506	    catalog: AssertionCatalog | None = None,
   507	    sensitivity_threshold: str | None = None,
   508	    evidence_plan: Mapping[str, Any] | None = None,
   509	) -> dict[str, Any]:
   510	    """Execute a full search run and return the ``search_run`` record.
   511	
   512	    CARP-4.1/4.3 (catalog-assisted-research-planning) additions, all
   513	    keyword-only with safe defaults that reproduce the pre-CARP behavior
   514	    exactly: ``identity``, ``catalog``, ``sensitivity_threshold``, and
   515	    ``evidence_plan``. They activate ONLY when ``request["retrieval"]
   516	    ["policy"]`` is ``"catalog_only"`` or ``"catalog_then_discovery"`` --
   517	    every legacy request (the field absent, or ``"disabled"``, the v1
   518	    default) runs the exact same discovery/extraction/metrics flow as
   519	    before this phase, byte-identical (carp-contract-freeze.md §1).
   520	
   521	    When active:
   522	
   523	    * ``evidence_plan`` (a pre-built ``research_evidence_plan`` dict -- e.g.
   524	      one :mod:`planning` already built and persisted over a brief's
   525	      questions) is consumed AS-IS: no retrieval happens inside this call.
   526	    * Otherwise, this request's own ``query`` is treated as ONE evidence-plan
   527	      question and evaluated live through the P2 adapter + P3 planner
   528	      (:func:`_build_ad_hoc_evidence_plan`) -- never the ledger, never a
   529	      provider.
   530	
   531	    Either way, the plan's covered/residual partition then governs
   532	    discovery: under ``catalog_only`` no provider is ever called (an empty
   533	    or denied catalog result is terminal); under ``catalog_then_discovery``
   534	    only the plan's residual question IDs generate a provider request --
   535	    covered questions are never re-queried and their selection is never
   536	    mutated by the discovery merge.
   537	    """
   538	
   539	    paths = paths or FoundryPaths.discover()
   540	    started = time.monotonic()
   541	    created_at = ids.now_iso()
   542	    schema_errors: list[str] = _validate(request, "search_request", paths)
   543	
   544	    query = str(request.get("query", ""))
   545	    mode = select_mode(request)
   546	    budget = Budget.from_request_dict(request).merge_mode_defaults(MODES[mode].budget)
   547	    tracker = BudgetTracker(budget)
   548	
   549	    # Mint a collision-free run id rooted at the query.
   550	    base_id = ids.run_id(query or "search")
   551	    run_id = ids.disambiguate_id(
   552	        base_id,
   553	        seed=query or base_id,
   554	        exists=lambda c: paths.run_dir(c).exists(),
   555	    )
   556	    rp = paths.run_paths(run_id)
   557	    rp.run.mkdir(parents=True, exist_ok=True)
   558	
   559	    providers_map = providers if providers is not None else all_providers()
   560	    chain = resolve_chain(mode, providers=providers_map)
   561	    constraints: dict[str, Any] = request.get("constraints", {}) or {}
   562	
   563	    # --- CARP-4.1/4.3: catalog retrieval phase ----------------------------
   564	    # Gated entirely on retrieval_policy != "disabled". A legacy request
   565	    # (the common case) never enters this block: plan_dict stays None,
   566	    # residual_question_ids stays empty, catalog_terminal stays False, and
