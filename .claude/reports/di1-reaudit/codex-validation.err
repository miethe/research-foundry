   255	@router.get(
   256	    "/admin/workspace",
   257	    summary="List workspace members and roles",
   258	    tags=["admin"],
   259	)
   260	def get_workspace_members(
   261	    request: Request,
   262	    paths: FoundryPaths = _PATHS_DEP,
   263	    _rbac: None = _RBAC_ADMIN,
   264	) -> dict[str, Any]:
   265	    """Return the member list for the caller's workspace.
   266	
   267	    Returns ``members: null`` when the workspace has no recorded memberships
   268	    (e.g. a freshly bootstrapped single-operator workspace that has not yet
   269	    synced its token-configured identities to the durable RBAC store).
   270	
   271	    Access: owner / admin only.  403 for all other authenticated roles.
   272	    In single-operator mode (no identity), passes unconditionally.
   273	    """
   274	    workspace_id = _resolve_workspace_id(request)
   275	    try:
   276	        conn = rbac_store.bootstrap(paths)
   277	        try:
   278	            members = rbac_store.list_workspace_members(conn, workspace_id)
   279	        finally:
   280	            conn.close()
   281	    except Exception as exc:
   282	        logger.warning("admin: failed to query workspace members: %s", exc)
   283	        raise HTTPException(status_code=500, detail="Failed to read workspace members") from exc
   284	
   285	    return {
   286	        "workspace_id": workspace_id,
   287	        "members": members if members else None,
   288	    }
