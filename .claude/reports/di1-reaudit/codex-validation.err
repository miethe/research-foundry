  3008	    ) -> None:
  3009	        """Start the Research Foundry loopback HTTP API (spec §loopback-api-v1).
  3010	
  3011	        Requires the ``serve`` extra::
  3012	
  3013	            pip install 'research-foundry[serve]'
  3014	
  3015	        The server binds to ``bind_host:port`` and exposes a read-only JSON API
  3016	        consumed by the runs viewer.
  3017	
  3018	        LAN exposure (``--bind-host 0.0.0.0``) requires ``--auth-mode token``
  3019	        AND the token env var (named by ``viewer.auth_token_env``, default
  3020	        ``RF_SERVE_TOKEN``) to be non-empty.  Both checks fail closed before
  3021	        any port is opened.
  3022	
  3023	        Example::
  3024	
  3025	            rf serve --port 7432 --bind-host 127.0.0.1
  3026	            rf serve --bind-host 0.0.0.0 --auth-mode token  # RF_SERVE_TOKEN must be set
  3027	        """
  3028	        import os as _os
  3029	
  3030	        # --- lazy import guard -----------------------------------------------
  3031	        try:
  3032	            import uvicorn
  3033	
  3034	            from .api.app import create_app
  3035	        except ImportError as exc:
  3036	            err_console.print(
  3037	                "[red]serve requires fastapi and uvicorn.[/red] "
  3038	                "Install with: pip install 'research-foundry[serve]'"
  3039	            )
  3040	            raise typer.Exit(1) from exc
  3041	
  3042	        from .config import FoundryConfig
  3043	
  3044	        config = FoundryConfig.load()
  3045	
  3046	        # Resolve effective auth_mode: CLI flag takes precedence over config.
  3047	        effective_auth_mode = auth_mode if auth_mode is not None else config.viewer_auth_mode()
  3048	        if effective_auth_mode not in ("none", "token"):
  3049	            err_console.print(
  3050	                f"[red]unknown auth-mode {effective_auth_mode!r}; use 'none' or 'token'[/red]"
  3051	            )
  3052	            raise typer.Exit(1)
  3053	
  3054	        # Resolve effective bind_host: CLI flag takes precedence over config.
  3055	        effective_bind_host = bind_host  # CLI always provides a default
  3056	
  3057	        # --- Step 1: Apply ALL CLI overrides to config BEFORE the gate runs -----
  3058	        # Architectural invariant: the gate and create_app must read the SAME
  3059	        # already-overridden config object. Applying overrides AFTER the gate
  3060	        # created a P1 bypass: the gate saw viewer.auth_mode=token (from YAML),
  3061	        # passed, then create_app saw auth_mode=none (from the CLI override
  3062	        # applied afterwards) and installed no middleware — server bound to LAN
  3063	        # with no auth protection.
  3064	        #
  3065	        # Scope of --auth-mode CLI flag: mutates viewer["auth_mode"] (the legacy
  3066	        # viewer.auth_mode path ONLY). The new auth.provider block (foundry.yaml
  3067	        # `auth:` section) is intentionally NOT overrideable via --auth-mode.
  3068	        # Use foundry.yaml to change auth.provider. This is the safer choice:
  3069	        # a stray --auth-mode none on a deployment using auth.provider=local_static
  3070	        # must NOT silently disable provider-level auth.
  3071	        if auth_mode is not None:
  3072	            config.viewer["auth_mode"] = effective_auth_mode
  3073	        if sensitivity_threshold is not None:
  3074	            config.viewer["sensitivity_threshold"] = sensitivity_threshold
  3075	        # --mode overrides foundry.yaml deployment_mode (FR-5). Mutates the
  3076	        # top-level `foundry` dict directly (same cached-dict-by-reference
  3077	        # pattern as viewer[...] above) so deployment_mode_validate() below
  3078	        # and create_app()'s later call both see the CLI-resolved value.
  3079	        if mode is not None:
  3080	            config.foundry["deployment_mode"] = mode
  3081	
  3082	        # --- Step 1.5: deployment_mode fail-closed startup gate (FR-4, partial
  3083	        # a-c; ACT-102 stub — condition (d) DI-1 ack lands in P4/ACT-402).
  3084	        # No-op for deployment_mode=single_user (the default); only ever
  3085	        # constrains multi_user. Runs BEFORE any port is opened, mirroring
  3086	        # the Step 2 gate below.
  3087	        try:
  3088	            config.deployment_mode_validate(bind_host=effective_bind_host)
  3089	        except ValueError as _mode_gate_err:
  3090	            err_console.print(f"[red]error:[/red] {_mode_gate_err}")
  3091	            raise typer.Exit(1) from _mode_gate_err
  3092	
  3093	        # --- Step 2: Fail-closed pre-bind validation (security invariants 1 & 2)
  3094	        # Both checks happen AFTER all CLI overrides are applied and BEFORE any
  3095	        # call to create_app or uvicorn.run so that no port is opened when the
  3096	        # configuration is unsafe. Single source of truth: gate and create_app
  3097	        # both read the same already-mutated config instance. Accepts EITHER the
  3098	        # new auth.provider=local_static path (P5) OR the legacy
  3099	        # viewer.auth_mode=token path — see _validate_nonloopback_bind.
  3100	        _LOOPBACK_HOSTS = frozenset({"127.0.0.1", "localhost", "::1"})
  3101	        is_loopback = effective_bind_host in _LOOPBACK_HOSTS
  3102	
  3103	        if not is_loopback:
  3104	            try:
  3105	                _validate_nonloopback_bind(
  3106	                    config, effective_bind_host, effective_auth_mode, _os.environ
  3107	                )
  3108	            except ValueError as _gate_err:
  3109	                err_console.print(f"[red]error:[/red] {_gate_err}")
  3110	                raise typer.Exit(1) from _gate_err
  3111	
  3112	        fastapi_app = create_app(config)
  3113	
  3114	        console.print(f"[green]rf serve[/green] listening on {effective_bind_host}:{port}")
  3115	        console.print(
  3116	            f"  auth_mode={effective_auth_mode}  "
  3117	            f"sensitivity_threshold={sensitivity_threshold or 'public (default)'}"
  3118	        )
  3119	
  3120	        uvicorn.run(fastapi_app, host=effective_bind_host, port=port)
  3121	
