   131	def _validate_nonloopback_bind(
   132	    config: Any,
   133	    effective_bind_host: str,
   134	    effective_auth_mode: str,
   135	    env: Any,
   136	) -> None:
   137	    """Validate that a non-loopback bind is safe before any port is opened.
   138	
   139	    Raises ``ValueError`` with an actionable message when the bind is unsafe.
   140	    The ``rf serve`` command calls this and converts ``ValueError`` → exit 1.
   141	
   142	    Checks (in order):
   143	
   144	    1. Auth must be enabled — either ``config.is_auth_enabled()`` (covers
   145	       both the new ``auth.provider`` path and the legacy
   146	       ``viewer.auth_mode`` path) or the CLI-override
   147	       ``effective_auth_mode`` resolves to ``"token"``.
   148	    2. At least one resolvable token must exist:
   149	       - ``auth.provider=local_static``: at least one configured
   150	         ``token_env`` env var must be non-empty.
   151	       - Legacy path: the ``viewer.auth_token_env`` env var must be
   152	         non-empty.
   153	
   154	    Args:
   155	        config: :class:`~research_foundry.config.FoundryConfig` instance.
   156	        effective_bind_host: The resolved bind address (e.g. ``"0.0.0.0"``).
   157	        effective_auth_mode: Resolved auth mode string (``"none"`` or
   158	            ``"token"``); may come from a CLI flag override.
   159	        env: Mapping to look up env var values (pass ``os.environ``).
   160	    """
   161	    # Gate 1: auth must be enabled (from config OR CLI override to "token").
   162	    if not config.is_auth_enabled() and effective_auth_mode != "token":
   163	        raise ValueError(
   164	            f"Cannot bind to non-loopback address {effective_bind_host!r}: "
   165	            "no auth is configured. Set auth.provider=local_static in "
   166	            "foundry.yaml or pass --auth-mode token."
   167	        )
   168	
   169	    # Gate 2: verify at least one resolvable token exists.
   170	    _auth_provider = "none"
   171	    try:
   172	        _auth_provider = config.auth_provider()
   173	    except ValueError:
   174	        pass  # Unimplemented/unrecognised provider — fall through to legacy check.
   175	
   176	    if _auth_provider == "local_static":
   177	        # New canonical path: at least one local_static token env var must be set.
   178	        token_configs = config.auth_local_static_tokens()
   179	        has_any_token = any(
   180	            bool(env.get(cfg.get("token_env", ""), ""))
   181	            for cfg in token_configs
   182	            if cfg.get("token_env")
   183	        )
   184	        if not has_any_token:
   185	            token_envs = [
   186	                cfg.get("token_env", "")
   187	                for cfg in token_configs
   188	                if cfg.get("token_env")
   189	            ]
   190	            env_desc = ", ".join(token_envs) if token_envs else "RF_SERVE_TOKEN_*, etc."
   191	            raise ValueError(
   192	                f"Cannot bind to non-loopback address: "
   193	                f"auth.provider=local_static is configured but no token env vars "
   194	                f"({env_desc}) are set. Set at least one token env var before "
   195	                f"binding to {effective_bind_host}."
   196	            )
   197	    else:
   198	        # Legacy path: viewer.auth_mode=token requires the token env var to be set.
   199	        token_env_var = config.viewer_auth_token_env()
   200	        token_value = env.get(token_env_var, "")
   201	        if not token_value:
   202	            raise ValueError(
   203	                f"{token_env_var} not set; refusing to bind on {effective_bind_host}"
   204	            )
   205	
