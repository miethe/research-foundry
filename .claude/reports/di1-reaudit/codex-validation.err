  1693	            if sid not in card_ids:
  1694	                continue
  1695	            # Compute effective rank (card level + per-point sensitivity) to
  1696	            # match the same logic used by check_report_body_sensitivity.
  1697	            card_rank = SENSITIVITY_ORDER.get(str(meta.get("sensitivity")), len(SENSITIVITY_ORDER))
  1698	            points = [p for p in (meta.get("extracted_points") or []) if isinstance(p, dict)]
  1699	            point_rank = card_rank
  1700	            for p in points:
  1701	                if p.get("sensitivity"):
  1702	                    point_rank = max(
  1703	                        point_rank,
  1704	                        SENSITIVITY_ORDER.get(str(p["sensitivity"]), len(SENSITIVITY_ORDER)),
  1705	                    )
  1706	            effective_rank = max(card_rank, point_rank)
  1707	            if effective_rank <= threshold_rank:
  1708	                continue
  1709	            quotes = [str(p.get("quote")) for p in points if p.get("quote")]
  1710	            if any(q and q in body_text for q in quotes):
  1711	                leaks.append(f"{sid} (run {run_id})")
  1712	
  1713	    if leaks:
  1714	        return CheckResult(
  1715	            id="report_body_sensitivity_global",
  1716	            severity="error",
  1717	            status="fail",
  1718	            detail=(
  1719	                f"draft body embeds raw sensitive-source text above threshold {threshold!r} "
  1720	                "(global scan): " + ", ".join(sorted(leaks))
  1721	            ),
  1722	            locations=sorted(leaks),
  1723	        )
  1724	    return CheckResult(
  1725	        id="report_body_sensitivity_global",
  1726	        severity="error",
  1727	        status="pass",
  1728	        detail=f"no raw sensitive-source text embedded above threshold {threshold!r} (global scan)",
  1729	        locations=[],
  1730	    )
  1731	
