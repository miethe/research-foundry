   787	    def resolve_workspace_isolation_enforced(self, provider: str, bind_host: str) -> bool:
   788	        """Resolve whether workspace row-level isolation is actively enforced.
   789	
   790	        This is called **once** at app-create time and the result is stored
   791	        on ``app.state.workspace_isolation_enforced``. Every subsequent query
   792	        in the catalog, builder, and agent-job services reads that flag
   793	        (via :func:`~research_foundry.api.auth.scope.resolve_workspace_isolation_active`)
   794	        to determine enforcement mode.
   795	
   796	        Structurally mirrors :meth:`resolve_rbac_enforced` (same fail-closed
   797	        gate, same ``_is_loopback`` reuse) but resolves the orthogonal
   798	        ``workspace_isolation_enforcement`` flag instead of
   799	        ``auth.rbac_enforcement`` — see the WKSP-304 decision log for why
   800	        isolation and RBAC are independent security gates.
   801	
   802	        Unlike :meth:`resolve_rbac_enforced` (whose ``AUTO`` branch always
   803	        returns ``True`` because RBAC enforcement is additionally gated by
   804	        the identity-None passthrough in ``require_role``), this resolver's
   805	        ``AUTO`` branch returns the literal provider-keyed truth table
   806	        documented on :class:`WorkspaceIsolationEnforcement`: enforcing when
   807	        ``provider != "none"``, advisory when ``provider == "none"``. When
   808	        enforced, :func:`~research_foundry.api.auth.scope.require_workspace_scope`
   809	        denies mismatched or null ``workspace_id`` (404 to the caller). When
   810	        advisory-only (the default for single-operator-trust deployments with
   811	        ``provider="none"``), a mismatch is logged but not denied. The
   812	        identity-None short-circuit in ``require_workspace_scope`` ensures
   813	        single-operator-trust callers (no auth middleware) never pay for,
   814	        and are never affected by, this flag lookup.
   815	
   816	        Parameters
   817	        ----------
   818	        provider:
   819	            The resolved ``auth.provider`` value (e.g. ``"none"``,
   820	            ``"local_static"``). Pass ``config.auth_provider()`` unless
   821	            you are writing tests that simulate specific provider states.
   822	        bind_host:
   823	            The ``viewer.bind_host`` value (e.g. ``"127.0.0.1"``,
   824	            ``"0.0.0.0"``). Used only for the fail-closed
   825	            ``disabled``-on-non-loopback gate.
   826	
   827	        Returns
   828	        -------
   829	        bool
   830	            ``True``  — isolation is enforced; :func:`~research_foundry.api.auth.scope.require_workspace_scope`
   831	            denies cross-workspace reads and mutations.
   832	            ``False`` — isolation is advisory-only; scope mismatches are logged but allowed.
   833	
   834	        Raises
   835	        ------
   836	        ValueError
   837	            When ``workspace_isolation_enforcement=disabled`` and
   838	            ``bind_host`` is not a loopback address. The server **must not
   839	            start** in this state.
   840	        """
   841	        enforcement = self.workspace_isolation_enforcement()
   842	
   843	        if enforcement == WorkspaceIsolationEnforcement.DISABLED:
   844	            if not _is_loopback(bind_host):
   845	                raise ValueError(
   846	                    f"workspace_isolation_enforcement=disabled is forbidden when "
   847	                    f"viewer.bind_host={bind_host!r} is a non-loopback address. "
   848	                    "Workspace isolation cannot be disabled on a public bind. "
   849	                    "Either set bind_host to a loopback address (127.0.0.1) or "
   850	                    "use workspace_isolation_enforcement=auto (the default)."
   851	                )
   852	            return False
   853	
   854	        if enforcement == WorkspaceIsolationEnforcement.ENABLED:
   855	            return True
   856	
   857	        # WorkspaceIsolationEnforcement.AUTO: enforced when provider != "none";
   858	        # advisory-only when provider == "none" (preserves the existing
   859	        # single-operator-trust default behaviour). See docstring above for
   860	        # why this differs from resolve_rbac_enforced's AUTO branch.
   861	        return provider != "none"
