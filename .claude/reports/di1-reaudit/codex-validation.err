   237	@router.post("/reports", summary="Create a report draft", status_code=201)
   238	def create_draft(
   239	    body: CreateDraftBody,
   240	    request: Request,
   241	    paths: FoundryPaths = _PATHS_DEP,
   242	    _rbac: None = _RBAC_REPORT_WRITE,
   243	) -> dict[str, Any]:
   244	    """Create a new draft.  Origin-driven dispatch:
   245	    - ``blank`` / ``template`` → empty draft with optional title/audience/sensitivity
   246	    - ``run``        → seed blocks from run's report_draft + report_anchors
   247	    - ``collection`` → one evidence_summary block per catalog item
   248	    """
   249	    # identity is wired into the blank/template create_draft() call below, and
   250	    # into create_draft_from_run()/create_draft_from_collection() (WKSP-304).
   251	    identity = getattr(request.state, "identity", None)
   252	    try:
   253	        if body.origin == "run":
   254	            if not body.source_run_id:
   255	                raise HTTPException(
   256	                    status_code=422,
   257	                    detail="origin 'run' requires source_run_id",
   258	                )
   259	            return stamp(
   260	                bsvc.create_draft_from_run(
   261	                    paths,
   262	                    run_id=body.source_run_id,
   263	                    title=body.title if body.title != "Untitled Draft" else None,
   264	                    audience=body.audience,
   265	                    sensitivity=body.sensitivity if body.sensitivity != "public" else None,
   266	                    project_id=body.project_id,
   267	                    workspace_id=body.workspace_id,
   268	                    created_by=body.created_by,
   269	                    sensitivity_threshold=body.sensitivity_threshold or "client_sensitive",
   270	                    identity=identity,
   271	                )
   272	            )
   273	        if body.origin == "collection":
   274	            ids_ = body.catalog_item_ids or (
   275	                [body.collection_id] if body.collection_id else []
   276	            )
   277	            if not ids_:
   278	                raise HTTPException(
   279	                    status_code=422,
   280	                    detail="origin 'collection' requires catalog_item_ids",
   281	                )
   282	            return stamp(
   283	                bsvc.create_draft_from_collection(
   284	                    paths,
   285	                    catalog_item_ids=ids_,
   286	                    title=body.title,
   287	                    audience=body.audience,
   288	                    sensitivity=body.sensitivity,
   289	                    project_id=body.project_id,
   290	                    workspace_id=body.workspace_id,
   291	                    created_by=body.created_by,
   292	                    sensitivity_threshold=body.sensitivity_threshold or "client_sensitive",
   293	                    identity=identity,
   294	                )
   295	            )
   296	        # blank / template / unknown origin → plain create_draft
   297	        return stamp(
   298	            bsvc.create_draft(
   299	                paths,
   300	                title=body.title,
   301	                origin=body.origin,
   302	                audience=body.audience,
   303	                sensitivity=body.sensitivity,
   304	                project_id=body.project_id,
   305	                workspace_id=body.workspace_id,
   306	                created_by=body.created_by,
   307	                identity=identity,
   308	            )
   309	        )
   310	    except bsvc.BuilderError as exc:
   311	        raise _builder_error(exc) from exc
