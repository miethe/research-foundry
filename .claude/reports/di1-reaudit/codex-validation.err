    53	class TestWorkspaceIsolationEnforcementParsing:
    54	    """Parser accepts all 3 valid values; raises ValueError on anything else."""
    55	
    56	    def test_default_is_auto(self, tmp_path):
    57	        """Absent key defaults to ``auto`` (mirrors auth.rbac_enforcement default)."""
    58	        cfg = _make_config(tmp_path)
    59	        assert cfg.workspace_isolation_enforcement() == WorkspaceIsolationEnforcement.AUTO
    60	
    61	    def test_parses_auto(self, tmp_path):
    62	        cfg = _make_config(tmp_path, workspace_isolation_enforcement="auto")
    63	        assert cfg.workspace_isolation_enforcement() == WorkspaceIsolationEnforcement.AUTO
    64	
    65	    def test_parses_enabled(self, tmp_path):
    66	        cfg = _make_config(tmp_path, workspace_isolation_enforcement="enabled")
    67	        assert cfg.workspace_isolation_enforcement() == WorkspaceIsolationEnforcement.ENABLED
    68	
    69	    def test_parses_disabled(self, tmp_path):
    70	        cfg = _make_config(tmp_path, workspace_isolation_enforcement="disabled")
