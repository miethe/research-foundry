   186	# --- Parsing ----------------------------------------------------------------
   187	
   188	
   189	@dataclass
   190	class _Sentence:
   191	    text: str
   192	    heading: str
   193	    has_tag: bool
   194	    tag_ids: list[str]
   195	    labeled: bool
   196	
   197	
   198	def _segment_sentences(body: str) -> list[_Sentence]:
   199	    """Split the report body into classified sentences, tracking the heading.
   200	
   201	    The report discipline is *one claim per line*: a content line that carries a
   202	    ``[claim:<id>]`` tag or an Inference/Speculation label is treated as a single
   203	    unit so a sentence-ending period inside the claim text does not detach the
   204	    trailing tag (which would spuriously flag the text as untagged). Lines with
   205	    neither a tag nor a label are split into sub-sentences so that several
   206	    injected untagged claims on one line are each caught.
   207	    """
   208	
   209	    out: list[_Sentence] = []
   210	    heading = ""
   211	    for raw_line in body.splitlines():
   212	        line = raw_line.strip()
   213	        if not line:
   214	            continue
   215	        if line.startswith("#"):
   216	            heading = line.lstrip("#").strip().lower()
   217	            continue
   218	        # Strip any HTML comment spans (a whole-line comment becomes empty and is
   219	        # skipped; a trailing real claim after an inline comment is preserved).
   220	        line = _HTML_COMMENT.sub("", line).strip()
   221	        if not line:
   222	            continue
   223	        # Bullet markers are content lines too; strip a leading list marker.
   224	        content = re.sub(r"^[-*+]\s+", "", line).strip()
   225	        if not content:
   226	            continue
   227	        line_tag_ids = _CLAIM_TAG.findall(content)
   228	        line_labeled = any(p.search(content) for p in _LABEL_PATTERNS.values())
   229	        if line_tag_ids or line_labeled:
   230	            # Keep the whole line together; the tag/label binds to the claim text.
   231	            pieces = [content]
   232	        else:
   233	            pieces = [p for p in _SENTENCE_SPLIT.split(content) if p.strip()]
   234	        for piece in pieces:
   235	            text = piece.strip()
   236	            if not text:
   237	                continue
   238	            tag_ids = _CLAIM_TAG.findall(text)
   239	            labeled = any(p.search(text) for p in _LABEL_PATTERNS.values())
   240	            out.append(
   241	                _Sentence(
   242	                    text=text,
   243	                    heading=heading,
   244	                    has_tag=bool(tag_ids),
   245	                    tag_ids=tag_ids,
   246	                    labeled=labeled,
   247	                )
   248	            )
   249	    return out
   250	
   251	
   252	# Citation-list headings whose lines are never material report claims.
   253	_CITATION_HEADINGS = {"sources", "references"}
   254	
   255	
   256	def _is_material(sentence: _Sentence, material_types: list[str]) -> bool:
   257	    """Heuristically decide if a sentence is a material claim of an active type."""
   258	
   259	    # Sources/references are citation lists, never claims.
   260	    if sentence.heading in _CITATION_HEADINGS:
   261	        return False
   262	    # Under "open questions", only genuine questions are exempt; a declarative
   263	    # material assertion relocated here is still checked (closes the laundering hole).
   264	    if sentence.heading == "open questions" and sentence.text.rstrip().endswith("?"):
   265	        return False
   266	    text = sentence.text
   267	    # Strip the claim tag and any label marker before pattern-matching so the
   268	    # tag/label tokens don't themselves trigger a heuristic.
   269	    stripped = _CLAIM_TAG.sub("", text)
   270	    for pat in _LABEL_PATTERNS.values():
   271	        stripped = pat.sub("", stripped)
   272	    for ctype in material_types:
   273	        pat = _MATERIAL_HEURISTICS.get(ctype)
   274	        if pat and pat.search(stripped):
   275	            return True
   276	    return False
   277	
   278	
   279	# --- Source-card resolution -------------------------------------------------
   280	
   281	
   282	def _index_source_cards(rp) -> dict[str, dict[str, Any]]:
   283	    """Map source_card_id -> {sensitivity, has_locator, has_quote, path, points} for the run.
   284	
   285	    ``has_quote`` (PRD FR-3.1) is ``True`` when the card has at least one
   286	    ``extracted_points[]`` entry with a non-empty ``quote`` — i.e. the card
   287	    can serve as an exact-passage anchor, not merely a locator-only citation.
   288	
   289	    ``points`` is the card's raw (dict-filtered) ``extracted_points[]`` list —
   290	    exposed so :func:`verify_report`'s ``pediatric_cds_schema_invalid`` check
   291	    (RFUP-1 P2-002) can inspect each point's optional ``pediatric_cds`` block
   292	    without a second read of the card's markdown file (AC-P2-6: zero new I/O).
   293	
   294	    ``extraction_status`` is the card's raw front-matter field (RFUP-1
   295	    P4-003) -- exposed so :func:`~.quote_fidelity.check_quote_fidelity` can
   296	    distinguish an ``extraction_status: locator_only`` card (nothing stored
   297	    to diff against, but genuinely unverifiable -> warn, AC-P4-7) from any
   298	    other card that happens to have no stored quote for some other reason
   299	    (unchanged silent skip). ``None`` when absent from front matter. Zero
   300	    new I/O -- read from the same already-loaded ``meta``.
   301	    """
   302	
   303	    index: dict[str, dict[str, Any]] = {}
   304	    sources_dir = rp.sources
   305	    if not sources_dir.exists():
   306	        return index
   307	    for p in sorted(sources_dir.glob("*.md")):
   308	        try:
   309	            meta, _ = load_md(p)
   310	        except Exception:  # noqa: BLE001 - a broken card is treated as missing
   311	            continue
   312	        sid = meta.get("source_card_id")
   313	        if not sid:
   314	            continue
   315	        src = meta.get("source", {}) if isinstance(meta.get("source"), dict) else {}
   316	        locator = src.get("locator", {}) if isinstance(src.get("locator"), dict) else {}
   317	        has_locator = bool(locator) and any(
   318	            v for v in locator.values() if v not in (None, "")
   319	        )
   320	        points = [pt for pt in (meta.get("extracted_points") or []) if isinstance(pt, dict)]
   321	        has_quote = any(pt.get("quote") for pt in points)
   322	        index[sid] = {
   323	            "sensitivity": meta.get("sensitivity"),
   324	            "has_locator": has_locator,
   325	            "has_quote": has_quote,
   326	            "path": str(p),
   327	            "points": points,
   328	            "extraction_status": meta.get("extraction_status"),
   329	        }
   330	    return index
   331	
   332	
   333	# Sentinel key prefix used by build_global_source_index when a run's
   334	# sources/ dir cannot be listed.  The check function treats any entry whose
   335	# key starts with this prefix as a hard blocker (fail-closed).
   336	_IO_ERROR_SENTINEL_PREFIX = "_io_error_"
   337	
   338	
   339	def build_global_source_index(paths: FoundryPaths) -> dict[str, tuple[str, str]]:
   340	    """Build a workspace-wide mapping: source_card_id -> (run_id, sensitivity).
   341	
   342	    Mirrors the shape of _index_source_cards but iterates every run in the
   343	    workspace rather than a single run.  Uses :func:`discover_run_yamls` so
   344	    nested run layouts (e.g. ``runs/sub/<id>/``) are included at any depth up
   345	    to 3, matching the export service's run discovery logic.
   346	
   347	    *run_id* stored in the tuple is the run directory's path **relative to**
   348	    ``paths.runs`` (e.g. ``"rf_run_abc"`` or ``"sub/rf_run_abc"``).  Consumers
   349	    like :func:`check_report_body_sensitivity_global` reconstruct the
   350	    ``sources/`` directory with ``paths.runs / run_id / "sources"``, which
   351	    resolves correctly for both flat and nested layouts via pathlib's slash
   352	    operator when the stored run_id contains a separator.
   353	
   354	    *sensitivity* is the **effective** value — the maximum of the card-level
   355	    ``meta.sensitivity`` and any per-point ``extracted_points[].sensitivity``
   356	    — matching the logic in :func:`check_report_body_sensitivity` so that a
   357	    card with a public card-level label but a work_sensitive extracted point
   358	    is indexed at the higher rank.
   359	
   360	    Fail-closed: if a run's sources/ dir cannot be read (I/O error, corrupt
   361	    dir), that run is included as a sentinel ("unknown", "restricted") rather
   362	    than silently omitted — preserving the fail-closed contract from
   363	    export_service.DEFAULT_THRESHOLD.
   364	    """
   365	    index: dict[str, tuple[str, str]] = {}
   366	    runs_dir = paths.runs
   367	    if not runs_dir.exists():
   368	        return index
   369	    try:
   370	        run_yamls = discover_run_yamls(runs_dir, max_depth=3)
   371	    except OSError:
   372	        return index
   373	
   374	    for run_yaml in run_yamls:
   375	        run_dir = run_yaml.parent
   376	        # Store the path relative to runs_dir so nested layouts resolve via
   377	        # paths.runs / run_id / "sources" in consumers.
   378	        run_id = str(run_dir.relative_to(runs_dir))
   379	        sources_dir = run_dir / "sources"
   380	        if not sources_dir.exists():
   381	            continue
   382	        try:
   383	            card_paths = sorted(sources_dir.glob("*.md"))
   384	        except OSError:
   385	            index[f"{_IO_ERROR_SENTINEL_PREFIX}{run_id}"] = ("unknown", "restricted")
   386	            continue
   387	        for card_path in card_paths:
   388	            try:
   389	                meta, _ = load_md(card_path)
   390	            except Exception:  # noqa: BLE001 - a broken card is treated as missing
   391	                continue
   392	            sid = meta.get("source_card_id")
   393	            if not sid:
   394	                continue
   395	            # Compute effective sensitivity: max(card-level rank, max point rank).
   396	            card_rank = SENSITIVITY_ORDER.get(str(meta.get("sensitivity") or ""), len(SENSITIVITY_ORDER))
   397	            points = [p for p in (meta.get("extracted_points") or []) if isinstance(p, dict)]
   398	            effective_rank = card_rank
   399	            for p in points:
   400	                if p.get("sensitivity"):
   401	                    effective_rank = max(
   402	                        effective_rank,
   403	                        SENSITIVITY_ORDER.get(str(p["sensitivity"]), len(SENSITIVITY_ORDER)),
   404	                    )
   405	            # Reverse-look up the canonical label; fall back to the raw card value
   406	            # for unknown ranks so the consumer's fail-closed SENSITIVITY_ORDER
   407	            # lookup still fires correctly.
   408	            effective_label = _SENSITIVITY_BY_RANK.get(
   409	                effective_rank, str(meta.get("sensitivity") or "")
   410	            )
   411	            index[str(sid)] = (run_id, effective_label)
   412	
   413	    return index
   414	
   415	
   416	# --- Helpers ----------------------------------------------------------------
   417	
   418	
   419	def _load_policy(paths: FoundryPaths) -> tuple[list[str], list[dict[str, Any]]]:
   420	    cfg = FoundryConfig(paths=paths)
   421	    policy = cfg.claim_policy if isinstance(cfg.claim_policy, dict) else {}
   422	    material = policy.get("material_claim_types") or _DEFAULT_MATERIAL_CLAIM_TYPES
   423	    checks = policy.get("verifier_checks") or _DEFAULT_VERIFIER_CHECKS
   424	    material = [str(m) for m in material if m]
   425	    checks = [c for c in checks if isinstance(c, dict) and c.get("id")]
   426	    return material, checks
   427	
   428	
   429	def _severity_for(check_id: str, checks: list[dict[str, Any]]) -> str:
   430	    for c in checks:
   431	        if c.get("id") == check_id:
   432	            return str(c.get("severity", "error"))
   433	    return "error"
   434	
   435	
   436	# --- pediatric_cds schema hard-gate (RFUP-1 P2-002, AC-P2-5/6/7) -----------
   437	#
   438	# Structural-completeness gate for the `pediatric_cds` evidence-card
   439	# extension block (schemas/pediatric_cds.schema.json, P2-001). Mirrors
   440	# resolve_exact_passage_mode's fail-closed convention: a broken *schema
   441	# config* (missing file / bad JSON) raises RFError immediately, distinct
   442	# from a card's *block content* failing validation against a good schema
   443	# (which is a normal "fail" + unsupported[] outcome, not an RFError).
   444	
   445	# services/verification.py -> parents[0]=services, [1]=research_foundry ->
   446	# .../src/research_foundry/schemas/pediatric_cds.schema.json (package-bundled
   447	# artifact; distinct from FoundryPaths.schemas, which resolves a *workspace's*
   448	# schemas/ dir and is not where this file lives).
   449	_PEDIATRIC_CDS_SCHEMA_PATH = (
   450	    Path(__file__).resolve().parents[1] / "schemas" / "pediatric_cds.schema.json"
   451	)
   452	
   453	
   454	@lru_cache(maxsize=1)
   455	def _load_pediatric_cds_schema() -> dict[str, Any]:
   456	    """Load+cache the pediatric_cds JSON Schema.
   457	
   458	    Raises
   459	    ------
   460	    RFError
   461	        If the schema file is missing, is not valid JSON, or its top level is
   462	        not a JSON object — a schema *configuration* problem that must fail
   463	        closed rather than silently disabling the hard-gate (AC-P2-5).
   464	        ``lru_cache`` does not memoize raised exceptions, so a transient
   465	        misconfiguration is re-checked (and can succeed) on the next call.
   466	    """
   467	
   468	    try:
   469	        raw = _PEDIATRIC_CDS_SCHEMA_PATH.read_text(encoding="utf-8")
   470	    except OSError as exc:
   471	        raise RFError(
   472	            "pediatric_cds schema config invalid: cannot read "
   473	            f"{_PEDIATRIC_CDS_SCHEMA_PATH}: {exc}"
   474	        ) from exc
   475	    try:
   476	        schema = json.loads(raw)
   477	    except json.JSONDecodeError as exc:
   478	        raise RFError(
   479	            "pediatric_cds schema config invalid: "
   480	            f"{_PEDIATRIC_CDS_SCHEMA_PATH} is not valid JSON: {exc}"
   481	        ) from exc
   482	    if not isinstance(schema, dict):
   483	        raise RFError(
   484	            "pediatric_cds schema config invalid: "
   485	            f"{_PEDIATRIC_CDS_SCHEMA_PATH} top level must be a JSON object"
   486	        )
   487	    return schema
   488	
   489	
   490	def _json_safe(obj: Any) -> Any:
   491	    """Round-trip *obj* through JSON so YAML-native types match JSON Schema's.
   492	
   493	    Source cards are loaded via ``yaml.safe_load`` (frontmatter.py ->
   494	    yamlio.py), which auto-parses unquoted ISO date-like scalars (e.g.
   495	    ``2026-07-22``) into ``datetime.date`` objects. The pediatric_cds schema
   496	    declares those same fields as JSON Schema ``"type": "string"`` (with
   497	    ``"format": "date"``), so validating the raw YAML-parsed value would
   498	    produce a false-positive type failure unrelated to the block's actual
   499	    content. ``default=str`` on the dump side stringifies any such object
   500	    (``str(date(...))`` == ``date(...).isoformat()``) before jsonschema ever

