   801	
   802	@router.post("/reports/{report_id}/verify", summary="Verify a draft (D13 checks)")
   803	def verify_draft_endpoint(
   804	    report_id: str,
   805	    request: Request,
   806	    sensitivity_threshold: str | None = Query(
   807	        None,
   808	        description="Override sensitivity threshold for the body-sensitivity check.",
   809	    ),
   810	    paths: FoundryPaths = _PATHS_DEP,
   811	    _rbac: None = _RBAC_REPORT_WRITE,
   812	) -> dict[str, Any]:
   813	    """Run all D13 checks against *report_id*.
   814	
   815	    Always returns 200 with a structured result (``passed``, per-check details).
   816	    Use /publish-preview for the fail-closed gate.
   817	    """
   818	    identity = getattr(request.state, "identity", None)  # noqa: F841 — reserved for WKSP-304 P4 (verify_draft() is services.verification, not builder_service, and has no identity param; not a Phase 3 scoping target)
   819	    try:
   820	        # TODO(WKSP-304 P4): verify_draft() (services.verification) does not accept identity (confirmed not a Phase 3 scoping target); wire once a future phase adds scoping here.
   821	        result = verify_draft(
   822	            paths, report_id, sensitivity_threshold=sensitivity_threshold
   823	        )
   824	    except NotFoundError as exc:
   825	        raise _not_found(report_id) from exc
   826	
   827	    return stamp(
   828	        {
   829	            "report_draft_id": report_id,
   830	            "passed": result.passed,
   831	            "exit_code": result.exit_code,
   832	            "checks": [
   833	                {
   834	                    "id": c.id,
   835	                    "severity": c.severity,
   836	                    "status": c.status,
   837	                    "detail": c.detail,
   838	                    "locations": c.locations,
   839	                }
   840	                for c in result.checks
   841	            ],
   842	            "unsupported": result.unsupported,
   843	        }
   844	    )
   845	
   846	
   847	@router.post("/reports/{report_id}/publish-preview", summary="Publish-preview gate (D13 fail-closed)")
   848	def publish_preview(
   849	    report_id: str,
   850	    request: Request,
   851	    sensitivity_threshold: str | None = Query(
   852	        None,
   853	        description=(
   854	            "Override sensitivity threshold for body-sensitivity check "
   855	            "(default: draft's own sensitivity label)."
   856	        ),
   857	    ),
   858	    paths: FoundryPaths = _PATHS_DEP,
   859	) -> dict[str, Any]:
   860	    """Run D13 checks FAIL-CLOSED and return a Markdown preview on pass.
   861	
   862	    **Failure behavior (spec §11)**:
   863	    - ``paragraph_has_support`` fails → ``{ok: false, blocking: [...]}`` + HTTP 422
   864	    - ``report_body_sensitivity`` fails (raw sensitive quote in body) → same
   865	    - Any other error-severity D13 failure → same
   866	
   867	    **Success**: ``{ok: true, preview_markdown: "...", checks: [...]}`` + HTTP 200
   868	
   869	    **PRD AC-2 — Role-independent fail-closed gate**:
   870	    The D13 sensitivity checks fire BEFORE the RBAC role gate.  Any
   871	    error-severity sensitivity failure returns 422 for ALL callers regardless of
   872	    their role — including ``owner`` and ``admin``.  No role can bypass the
   873	    sensitivity gate.  RBAC (``report:publish`` → owner/admin only) is enforced
   874	    in step 3, after the sensitivity gate passes.
   875	
   876	    The preview Markdown is generated from the current draft blocks.  Nothing
   877	    is persisted — callers decide whether to actually publish.
   878	
   879	    **RBAC-901 note**: this route enforces ``report:publish`` (owner/admin)
   880	    manually rather than via ``Depends(require_role(...))`` so that the
   881	    sensitivity gate (step 2, 422) fires before the role gate (step 3, 403).
   882	    The test_rbac_route_sweep.py MANUALLY_GATED_ROUTES exemption documents this.
   883	    """
   884	    # Resolve caller identity once — used in both the RBAC pre-check below
   885	    # and the post-sensitivity RBAC gate (step 3).
   886	    # RBAC-disabled: when app.state.rbac_enforced is False the global
   887	    # require_role() is a no-op; this manual gate must honor the same toggle so
   888	    # that loopback/disabled mode is consistent end-to-end (DEFECT P2 fix).
   889	    _app_state = getattr(getattr(request, "app", None), "state", None)
   890	    rbac_enforced: bool | None = (
   891	        getattr(_app_state, "rbac_enforced", None) if _app_state is not None else None
   892	    )
   893	    identity = getattr(request.state, "identity", None)
   894	    _has_publish_perm: bool = (rbac_enforced is False) or identity is None or bool(
   895	        set(identity.roles) & {"owner", "admin"}
   896	    )
   897	
   898	    # Step 1: Sensitivity-first D13 verification (PRD AC-2 invariant).
   899	    # verify_draft loads the draft and runs all D13 checks BEFORE the RBAC
   900	    # check below, so a sensitivity violation (422) cannot be bypassed by
   901	    # choosing a higher-privileged role.
   902	    try:
   903	        result = verify_draft(
   904	            paths, report_id, sensitivity_threshold=sensitivity_threshold
   905	        )
   906	    except NotFoundError as exc:
   907	        # Draft not found.  Under-privileged callers get 403 (existence pre-check)
   908	        # so probing for non-existent report IDs is indistinguishable from
   909	        # "you lack the report:publish permission."
   910	        if not _has_publish_perm:
   911	            raise HTTPException(status_code=403, detail="Insufficient role") from exc
   912	        raise _not_found(report_id) from exc
   913	
   914	    check_dicts = [
   915	        {
   916	            "id": c.id,
   917	            "severity": c.severity,
   918	            "status": c.status,
   919	            "detail": c.detail,
   920	            "locations": c.locations,
   921	        }
   922	        for c in result.checks
   923	    ]
   924	
   925	    # Step 2: Role-independent sensitivity gate (PRD AC-2).
   926	    # 422 fires for ALL callers regardless of role when any error-severity
   927	    # D13 check fails.  This is the "publish_preview must be role-independent
   928	    # fail-closed" requirement — no privileged role can bypass this.
   929	    blocking = [c for c in check_dicts if c["severity"] == "error" and c["status"] == "fail"]
   930	    if blocking:
   931	        # Audit: record denied publish-preview before raising (fail-open).
   932	        audit_service.record_event(
   933	            paths,
   934	            AuditEvent(
   935	                mutation_type="publish_preview",
   936	                action="publish_preview",
   937	                target_ref=report_id,
   938	                result="denied",
   939	                error_detail=str([c["id"] for c in blocking]),
   940	            ),
   941	        )
   942	        raise HTTPException(
   943	            status_code=422,
   944	            detail={
   945	                "ok": False,
   946	                "blocking": blocking,
   947	                "checks": check_dicts,
   948	            },
   949	        )
   950	
   951	    # Step 3: RBAC gate — reached only when all D13 sensitivity checks pass.
   952	    # Only owner/admin hold report:publish permission.
   953	    if not _has_publish_perm:
   954	        raise HTTPException(status_code=403, detail="Insufficient role")
   955	
   956	    # Step 4: Generate Markdown preview (no side-effects on draft state).
   957	    try:
   958	        preview_md = bsvc.export_markdown(paths, report_id, identity=identity)
   959	    except NotFoundError as exc:  # pragma: no cover  — already verified load above
   960	        raise _not_found(report_id) from exc
   961	
   962	    # Audit: record successful publish-preview (fail-open).
   963	    audit_service.record_event(
   964	        paths,
   965	        AuditEvent(
   966	            mutation_type="publish_preview",
   967	            action="publish_preview",
   968	            target_ref=report_id,
   969	            result="success",
   970	        ),
   971	    )
   972	
   973	    # Step 5: Audit-health gate (REVIEW-001 must-fix, AUDIT-004).
   974	    # Unconditional regardless of RBAC-enforcement mode — a degraded audit
   975	    # store must not silently allow exposure of preview content just because
   976	    # this caller cleared the sensitivity gate (step 1/2) and the RBAC gate
   977	    # (step 3).  record_event() above stays fail-open and unchanged; this
   978	    # check is purely additive.
   979	    if not audit_service.is_healthy_for_exposure(paths):
   980	        raise HTTPException(status_code=503, detail="Audit log unavailable")
   981	
   982	    return stamp(
   983	        {
   984	            "ok": True,
   985	            "preview_markdown": preview_md,
   986	            "checks": check_dicts,
   987	        }
   988	    )
   989	
   990	
   991	# ---------------------------------------------------------------------------
   992	# Export
   993	# ---------------------------------------------------------------------------
   994	
   995	
   996	@router.get("/reports/{report_id}/export", summary="Export draft as Markdown")
   997	def export_draft(
   998	    report_id: str,
   999	    request: Request,
  1000	    sensitivity_threshold: str | None = Query(
  1001	        None,
  1002	        description="Override foundry.yaml viewer.sensitivity_threshold (default: public).",
  1003	    ),
  1004	    paths: FoundryPaths = _PATHS_DEP,
  1005	) -> dict[str, Any]:
  1006	    """Return the draft rendered as Markdown with YAML frontmatter.
  1007	
  1008	    404 for unknown ids AND drafts whose sensitivity exceeds the resolved threshold
  1009	    (no-existence-leak, mirrors ``get_draft`` gating).  The sensitivity check runs
  1010	    before any content is returned.
  1011	
  1012	    The response carries ``{"report_draft_id": ..., "markdown": "..."}`` so
  1013	    callers can display or save the output without additional parsing.
  1014	    """
  1015	    identity = getattr(request.state, "identity", None)
  1016	    threshold_rank = _resolve_threshold_rank(paths, sensitivity_threshold, request)
  1017	    try:
  1018	        draft = bsvc.load_draft(paths, report_id, identity=identity)
  1019	    except NotFoundError as exc:
  1020	        raise _not_found(report_id) from exc
  1021	    if _sensitivity_rank(draft.get("sensitivity")) > threshold_rank:
  1022	        raise _not_found(report_id)
  1023	    try:
  1024	        md = bsvc.export_markdown(paths, report_id, identity=identity)
  1025	    except NotFoundError as exc:
  1026	        raise _not_found(report_id) from exc
  1027	    return stamp({"report_draft_id": report_id, "markdown": md})
  1028	
  1029	
  1030	# ---------------------------------------------------------------------------
  1031	# Share links (Phase 5.6 — D5: READ-ONLY, sensitivity-scoped share primitive)
  1032	#
  1033	# Design decision (D5 / LOCKED):
  1034	#   v1 shares are READ-ONLY tokens scoped to a single draft at a fixed
