  1024	    audit_service.record_event(
  1025	        paths,
  1026	        AuditEvent(
  1027	            mutation_type="access_token_issued",
  1028	            action="pat_issued",
  1029	            target_ref=issued.token_id,
  1030	            actor_user_id=identity.user_id if identity is not None else None,
  1031	            actor_workspace_id=workspace_id,
  1032	            result="success",
  1033	        ),
  1034	    )
  1035	    return _issued_token_response(issued)
