   425	    """Return revision pointer list (report_version_id, created_at, note) for *report_id*.
   426	
   427	    404 for unknown ids AND drafts whose sensitivity exceeds the resolved threshold
   428	    (no-existence-leak, mirrors ``get_draft`` gating).
   429	    """
   430	    identity = getattr(request.state, "identity", None)
   431	    threshold_rank = _resolve_threshold_rank(paths, sensitivity_threshold, request)
   432	    try:
   433	        draft = bsvc.load_draft(paths, report_id, identity=identity)
   434	    except NotFoundError as exc:
   435	        raise _not_found(report_id) from exc
   436	    if _sensitivity_rank(draft.get("sensitivity")) > threshold_rank:
   437	        raise _not_found(report_id)
   438	    try:
   439	        # TODO(WKSP-304 P4): bsvc.list_revisions() does not accept identity (confirmed not a Phase 3 scoping target); wire once a future phase adds scoping here.
   440	        return bsvc.list_revisions(paths, report_id)
