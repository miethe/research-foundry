   907	def restore_revision(
   908	    paths: FoundryPaths, report_draft_id: str, report_version_id: str, *, updated_by: str | None = None
   909	) -> dict[str, Any]:
   910	    """Overwrite the draft's content fields with a prior revision snapshot.
   911	
   912	    Does not itself create a new revision — callers wanting a pre-restore
   913	    checkpoint should call :func:`create_revision` first.
   914	    """
   915	
   916	    snapshot = get_revision(paths, report_draft_id, report_version_id)
   917	    draft = load_draft(paths, report_draft_id)
   918	    for k in _SNAPSHOT_FIELDS:
   919	        draft[k] = snapshot[k]
   920	    _touch(draft, updated_by)
   921	    return _save_draft(paths, draft)
