   388	def get_event(
   389	    paths: FoundryPaths,
   390	    audit_event_id: str,
   391	    *,
   392	    identity: Optional[AuthIdentity] = None,
   393	) -> Optional[dict[str, Any]]:
   394	    """Return a single audit event by ID, or ``None`` if not found.
   395	
   396	    The caller (router) is responsible for mapping ``None`` to a 404 response.
   397	
   398	    ``identity`` is DI-1 full-surface audit scoping (Phase 4 ACT-401): this
   399	    lookup previously had **no** workspace check at all, so any owner/admin
   400	    (a workspace-scoped role — see :func:`list_events`) could read any other
   401	    workspace's audit event by ID. When ``identity`` is not ``None`` and
   402	    isolation is actively enforced, a row whose ``actor_workspace_id`` does
   403	    not match ``identity.workspace_id`` is treated exactly like a missing
   404	    event (``None``) — the same fail-closed, indistinguishable-404 contract
   405	    every other cross-workspace read in this codebase uses (e.g.
   406	    ``catalog_service.get_item``, ``builder_service.load_draft``).
   407	    ``identity=None`` (the default) or isolation inactive is byte-identical
   408	    to the pre-Phase-4 behavior.
   409	    """
   410	    conn = _connect(paths)
   411	    try:
   412	        _ensure_schema(conn)
   413	        conn.row_factory = sqlite3.Row
   414	        row = conn.execute(
   415	            "SELECT * FROM audit_event WHERE audit_event_id = ?",
   416	            (audit_event_id,),
   417	        ).fetchone()
   418	        if row is None:
   419	            return None
   420	        result = _row_to_dict(row)
   421	        if identity is not None and _isolation_active(paths):
   422	            if result.get("actor_workspace_id") != identity.workspace_id:
   423	                log.error(
   424	                    json.dumps(
   425	                        {
   426	                            "event": "workspace_scope_enforced_denial",
   427	                            "record_type": "audit_event",
   428	                            "record_id": audit_event_id,
   429	                            "record_workspace_id": result.get("actor_workspace_id"),
   430	                            "identity_workspace_id": identity.workspace_id,
   431	                        }
   432	                    )
   433	                )
   434	                return None
   435	        return result
   436	    finally:
   437	        conn.close()
   438	
   439	
