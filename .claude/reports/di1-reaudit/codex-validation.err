   224	def _read_rate_limit(request: Request, config: FoundryConfig) -> dict[str, Any]:
   225	    """Merge in-memory overrides with config defaults to produce the current budget.
   226	
   227	    ``enabled`` is always sourced from ``foundry.yaml`` (startup-only); it is
