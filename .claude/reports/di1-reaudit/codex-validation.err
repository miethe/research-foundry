   240	        principal_id=principal_id,
   241	        workspace_id=workspace_id,
   242	        role=role,
   243	        token_hash=token_hash,
   244	        token_prefix=token_prefix,
   245	        created_by=created_by,
   246	        expires_at=expires_at,
   247	    )
   248	
   249	    return IssuedToken(
   250	        token_id=token_id,
   251	        plaintext=full_token,
   252	        token_prefix=token_prefix,
   253	        principal_type=principal_type,
   254	        principal_id=principal_id,
   255	        workspace_id=workspace_id,
   256	        role=role,
   257	        expires_at=expires_at,
   258	    )
