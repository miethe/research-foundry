   695	            return {"status": item.get("status")}
   696	        return None
   697	    if source_run_id:
   698	        rp = paths.run_paths(source_run_id)
   699	        if rp.claim_ledger.exists():
   700	            ledger = load_yaml(rp.claim_ledger) or {}
   701	            for c in ledger.get("claims") or []:
   702	                if isinstance(c, dict) and c.get("claim_id") == claim_id:
   703	                    return {"status": c.get("status")}
   704	    return None
