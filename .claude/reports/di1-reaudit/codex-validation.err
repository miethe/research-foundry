   338	@router.get("/reports/{report_id}", summary="Get report draft detail")
   339	def get_draft(
   340	    report_id: str,
   341	    request: Request,
   342	    sensitivity_threshold: str | None = Query(
   343	        None,
   344	        description="Override foundry.yaml viewer.sensitivity_threshold (default: public).",
   345	    ),
   346	    paths: FoundryPaths = _PATHS_DEP,
   347	) -> dict[str, Any]:
   348	    """Return the full draft state for *report_id* (a ``rpt_`` id).
   349	
   350	    404 for unknown ids, ids that resolve to a run, AND a draft whose
   351	    sensitivity exceeds the resolved threshold — all indistinguishable
   352	    (no-existence-leak, landmine #4; R2 fix: this endpoint previously applied
   353	    zero sensitivity gating, unlike ``catalog_service.get_item``).
   354	    """
   355	    identity = getattr(request.state, "identity", None)
   356	    threshold_rank = _resolve_threshold_rank(paths, sensitivity_threshold, request)
   357	    try:
   358	        draft = bsvc.load_draft(paths, report_id, identity=identity)
   359	    except NotFoundError as exc:
   360	        raise _not_found(report_id) from exc
   361	    if _sensitivity_rank(draft.get("sensitivity")) > threshold_rank:
   362	        raise _not_found(report_id)
   363	    return stamp(draft)
   364	
   365	
   366	@router.delete("/reports/{report_id}", summary="Delete a report draft", status_code=204)
   367	def delete_draft(
   368	    report_id: str,
   369	    request: Request,
   370	    paths: FoundryPaths = _PATHS_DEP,
   371	    _rbac: None = _RBAC_REPORT_ADMIN,
   372	) -> None:
   373	    """Delete draft directory (draft.yaml + revisions) and its catalog index row.
   374	
   375	    Idempotent: deleting a non-existent (but well-formed) draft id returns
   376	    204. A malformed id (bad shape / traversal attempt) 404s instead — the
   377	    service layer's :func:`~research_foundry.services.builder_service._draft_dir`
   378	    raises :class:`NotFoundError` before anything is touched on disk.
   379	
   380	    WKSP-304 P4 (TASK-4.3, AC-5): a workspace-scoped pre-flight check gates
   381	    the actual delete, but the idempotent-204 contract above must survive it.
   382	    ``bsvc.load_draft`` cannot distinguish "malformed id" / "genuinely
   383	    missing" from "exists but is cross-workspace-denied" — all three raise
   384	    the same :class:`NotFoundError` (by design, no-existence-leak). So when
   385	    the identity-scoped load denies, a second identity=None probe (byte-
   386	    identical to pre-Phase-4 behavior) tells us which case we are in: if the
   387	    draft doesn't exist AT ALL either, this is the pre-existing idempotent
   388	    no-op path — fall through unchanged to ``bsvc.delete_draft`` below. If
   389	    the identity=None probe SUCCEEDS, the draft genuinely exists in another
   390	    workspace — fail closed (404) WITHOUT ever calling ``bsvc.delete_draft``,
   391	    so no cross-workspace file is ever touched.
   392	    """
   393	    identity = getattr(request.state, "identity", None)
   394	    if identity is not None:
   395	        try:
   396	            bsvc.load_draft(paths, report_id, identity=identity)
   397	        except NotFoundError:
   398	            try:
   399	                bsvc.load_draft(paths, report_id, identity=None)
   400	            except NotFoundError:
   401	                pass  # genuinely missing / malformed — idempotent path below.
   402	            else:
   403	                raise _not_found(report_id)
   404	    try:
   405	        bsvc.delete_draft(paths, report_id)
   406	    except NotFoundError as exc:
   407	        raise _not_found(report_id) from exc
   408	
