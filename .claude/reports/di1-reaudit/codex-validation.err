   736	def _resolve_explicit_path(rp, given: Path | None, label: str) -> Path | None:
   737	    """Resolve an explicitly-provided path: run-dir first, then CWD.
   738	
   739	    When *given* is ``None`` the caller uses auto-discovery (not this function).
   740	    When *given* is not ``None`` and cannot be found anywhere, raise ``RFError``
   741	    with a clear message so the caller aborts *before* writing any output files.
   742	    """
   743	    if given is None:
   744	        return None
   745	    p = Path(given)
   746	    if p.is_absolute():
   747	        if p.exists():
   748	            return p
   749	        raise RFError(f"{label} path not found: {p}")
   750	    # Relative path: try run directory first, then CWD.
   751	    run_relative = rp.run / p
   752	    if run_relative.exists():
   753	        return run_relative
   754	    cwd_relative = Path.cwd() / p
   755	    if cwd_relative.exists():
   756	        return cwd_relative
   757	    raise RFError(f"{label} path not found: {p} (tried {run_relative} and {cwd_relative})")
