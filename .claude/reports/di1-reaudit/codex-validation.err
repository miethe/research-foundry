   180	    # config defaults.  Cleared on restart (intentional — use foundry.yaml for
   181	    # persistent overrides).
   182	    app.state.rate_limit_overrides = {}
   183	
   184	    # --- fix/catalog-visibility: catalog sensitivity-threshold override -----
   185	    #
   186	    # `rf serve --sensitivity-threshold <X>` mutates `config.viewer
   187	    # ["sensitivity_threshold"]` in cli_commands.py's serve() BEFORE calling
   188	    # create_app() (see that function's "Apply ALL CLI overrides to config
   189	    # BEFORE the gate runs" comment) — so by the time we get here, `config`
   190	    # already reflects the correct precedence: explicit CLI flag > whatever
   191	    # foundry.yaml has on disk.
   192	    #
   193	    # Without this, that resolved value went nowhere: the catalog router only
   194	    # receives a bare `FoundryPaths` via the `get_paths()` dependency, which
   195	    # is a *fresh* `FoundryConfig.load()` — a different instance from `config`
   196	    # that re-reads foundry.yaml from disk and has never seen the CLI-time
   197	    # mutation. `catalog_service.resolve_threshold()` falls back to the same
   198	    # kind of fresh disk read when no explicit override reaches it. Result: an
   199	    # explicit `--sensitivity-threshold` flag was silently ignored by every
