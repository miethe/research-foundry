  1083	@router.delete(
  1084	    "/admin/pats/{token_id}",
  1085	    summary="Revoke a personal access token (self, or any via owner/admin)",
  1086	    tags=["admin"],
  1087	)
  1088	def revoke_pat(
  1089	    token_id: str,
  1090	    request: Request,
  1091	    paths: FoundryPaths = _PATHS_DEP,
  1092	) -> dict[str, Any]:
  1093	    """Revoke a PAT by id.
  1094	
  1095	    404 when the token is unknown, is a service-account token (not a PAT —
  1096	    hidden behind this endpoint's 404 rather than exposed as "wrong type"),
  1097	    or belongs to a DIFFERENT workspace (existence not confirmed, mirroring
  1098	    ``audit.py``'s cross-workspace convention).
  1099	
  1100	    403 when the token exists in the caller's OWN workspace but belongs to a
  1101	    different user AND the caller lacks owner/admin — existence is knowable
  1102	    here (the caller is a legitimate member of that workspace) but the
  1103	    action is denied; never a 404-leak (ACT-302 acceptance criteria).
  1104	    """
  1105	    identity = _get_identity(request)
  1106	
  1107	    token = token_service.get_token(paths, token_id)
  1108	    if token is None or token["principal_type"] != "user_pat":
  1109	        raise HTTPException(status_code=404, detail=f"PAT {token_id!r} not found")
  1110	    if identity is not None and token["workspace_id"] != identity.workspace_id:
  1111	        # Cross-workspace: hide existence entirely (404), never a 403.
  1112	        raise HTTPException(status_code=404, detail=f"PAT {token_id!r} not found")
  1113	    if (
  1114	        identity is not None
  1115	        and token["principal_id"] != identity.user_id
  1116	        and not _is_owner_or_admin(identity)
  1117	    ):
  1118	        raise HTTPException(
  1119	            status_code=403,
  1120	            detail="Insufficient role to revoke another user's PAT",
  1121	        )
  1122	
  1123	    token_service.revoke_token(paths, token_id)
  1124	
  1125	    audit_service.record_event(
  1126	        paths,
  1127	        AuditEvent(
  1128	            mutation_type="access_token_revoked",
  1129	            action="pat_revoked",
  1130	            target_ref=token_id,
  1131	            actor_user_id=identity.user_id if identity is not None else None,
  1132	            actor_workspace_id=token["workspace_id"],
  1133	            result="success",
  1134	        ),
  1135	    )
  1136	    return {"token_id": token_id, "revoked": True}
