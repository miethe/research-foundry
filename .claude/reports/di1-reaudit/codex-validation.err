   469	@router.get("/reports/{report_id}/versions/{version_id}", summary="Get a revision snapshot")
   470	def get_version(
   471	    report_id: str,
   472	    version_id: str,
   473	    request: Request,
   474	    sensitivity_threshold: str | None = Query(
   475	        None,
   476	        description="Override foundry.yaml viewer.sensitivity_threshold (default: public).",
   477	    ),
   478	    paths: FoundryPaths = _PATHS_DEP,
   479	) -> dict[str, Any]:
   480	    """Return the full snapshot for *version_id* under *report_id*.
   481	
   482	    404 for unknown ids AND drafts whose sensitivity exceeds the resolved threshold
   483	    (no-existence-leak, mirrors ``get_draft`` gating).
   484	    """
   485	    identity = getattr(request.state, "identity", None)
   486	    threshold_rank = _resolve_threshold_rank(paths, sensitivity_threshold, request)
   487	    try:
   488	        draft = bsvc.load_draft(paths, report_id, identity=identity)
   489	    except NotFoundError as exc:
   490	        raise _not_found(report_id) from exc
   491	    if _sensitivity_rank(draft.get("sensitivity")) > threshold_rank:
   492	        raise _not_found(report_id)
   493	    try:
   494	        # TODO(WKSP-304 P4): bsvc.get_revision() does not accept identity (confirmed not a Phase 3 scoping target); wire once a future phase adds scoping here.
   495	        return stamp(bsvc.get_revision(paths, report_id, version_id))
   496	    except NotFoundError as exc:
   497	        raise HTTPException(status_code=404, detail="revision not found") from exc
   498	
   499	
   500	@router.post(
   501	    "/reports/{report_id}/versions/{version_id}/restore",
