   443	
   444	
   445	def _row_to_dict(row: sqlite3.Row) -> dict[str, Any]:
   446	    """Convert a ``sqlite3.Row`` to a plain ``dict``.
   447	
   448	    ``policy_snapshot`` is JSON-decoded when present.
   449	    """
   450	    d = dict(row)
   451	    if d.get("policy_snapshot") is not None:
   452	        try:
   453	            d["policy_snapshot"] = json.loads(d["policy_snapshot"])
   454	        except (json.JSONDecodeError, TypeError):
   455	            pass  # Return the raw string rather than crashing
   456	    return d
