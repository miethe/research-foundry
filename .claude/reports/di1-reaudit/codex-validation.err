   211	def _issue(
   212	    conn,
   213	    *,
   214	    principal_type: str,
   215	    principal_id: str,
   216	    workspace_id: str,
   217	    role: str,
   218	    created_by: Optional[str],
   219	    expires_at: Optional[str],
   220	) -> IssuedToken:
   221	    """Shared issuance path for both service-account and PAT tokens.
   222	
   223	    Generates the secret, hashes it, and persists the row via
   224	    ``rbac_store.create_access_token``.  Never called directly by external
   225	    callers -- use :func:`issue_service_account_token` or
   226	    :func:`issue_user_pat`, both of which resolve/validate the principal
