   110	# ---------------------------------------------------------------------------
   111	
   112	
   113	def require_workspace_scope(
   114	    identity: AuthIdentity | None,
   115	    record: dict[str, Any] | object,
   116	    *,
   117	    record_type: str = "unknown",
   118	    record_id: str | None = None,
   119	    resolve_enforcement: Callable[[], bool] | None = None,
   120	) -> WorkspaceScopeResult:
   121	    """Workspace scope predicate — advisory by default, enforcing when armed.
   122	
   123	    When ``identity`` is ``None`` (single-operator-trust mode — no auth
   124	    middleware is configured), this function returns immediately with
   125	    ``allowed=True, reason="single_operator_trust"``.  This is the literal
   126	    first statement in the function body (WKSP-304 D3 — Critical, no partial
   127	    credit): ``resolve_enforcement`` is never read or invoked on this path,
   128	    so single-operator-trust callers never pay for, and can never be affected
   129	    by, the enforcement-flag lookup.
   130	
   131	    When ``identity`` is not ``None``, ``resolve_enforcement`` (if supplied)
   132	    is called exactly once to resolve whether WKSP-304 workspace isolation is
   133	    currently enforcing:
   134	
   135	    * **Enforcing** (``resolve_enforcement`` supplied and resolves truthy):
   136	      a ``record.workspace_id`` mismatch — including ``None`` / absent,
   137	      which is treated as a mismatch and never defaulted to allowed — denies
   138	      the request (``allowed=False, reason="workspace_mismatch_denied"``).
   139	      An exact match still allows (``reason="workspace_match"``).
   140	    * **Advisory** (no resolver passed, or the resolver resolves falsy —
   141	      the WKSP-301 default, unchanged pre-Phase-4 behaviour): a mismatch or
   142	      null ``workspace_id`` emits a structured JSON advisory log event at
   143	      ``WARNING`` level and still returns ``allowed=True,
   144	      reason="advisory_mode"``.  An exact match returns
   145	      ``allowed=True, reason="workspace_match"`` with no log.
   146	
   147	    Parameters
   148	    ----------
   149	    identity:
   150	        Resolved caller identity (from ``request.state.identity`` on the HTTP
   151	        path) or ``None`` for CLI / single-operator-trust callers.
   152	    record:
   153	        The record being returned to the caller.  ``workspace_id`` is resolved
   154	        via ``record.get("workspace_id")`` (dict) or
   155	        ``getattr(record, "workspace_id", None)`` (object).
   156	    record_type:
   157	        Human-readable record type label (e.g. ``"catalog_item"``,
   158	        ``"draft"``).  Included in the advisory log event.
   159	    record_id:
   160	        Stable identifier for the record.  When not supplied, derived from
   161	        common field names (``catalog_item_id``, ``report_draft_id``, ``id``).
   162	    resolve_enforcement:
   163	        Optional zero-arg callable resolving whether WKSP-304 workspace
   164	        isolation enforcement is currently active (e.g. a service's
   165	        ``_isolation_active`` helper).  Defaults to ``None``, which resolves
   166	        to advisory-only — existing callers that do not pass this parameter
   167	        keep byte-for-byte WKSP-301 behaviour until they are updated
   168	        (WKSP-304 TASK-4.2/4.3) to pass a resolver.
   169	
   170	    Returns
   171	    -------
   172	    WorkspaceScopeResult
   173	    """
   174	    if identity is None:
   175	        # Single-operator trust mode — no workspace context to compare.
   176	        # D3: returns before `resolve_enforcement` is ever read/called.
   177	        return WorkspaceScopeResult(allowed=True, reason="single_operator_trust")
   178	
   179	    # WKSP-304 TASK-4.1: the enforcement flag is resolved here — only ever
   180	    # reached once the identity=None short-circuit above has already
   181	    # returned. Absent a resolver, this defaults to advisory-only (False).
   182	    enforcing = resolve_enforcement() if resolve_enforcement is not None else False
   183	
   184	    # Resolve workspace_id + record_id from the record.
   185	    if isinstance(record, dict):
   186	        rec_workspace_id: str | None = record.get("workspace_id")
   187	        if record_id is None:
   188	            record_id = (
   189	                record.get("catalog_item_id")
   190	                or record.get("report_draft_id")
   191	                or str(record.get("id", "unknown"))
   192	            )
   193	    else:
   194	        rec_workspace_id = getattr(record, "workspace_id", None)
   195	        if record_id is None:
   196	            record_id = str(getattr(record, "id", "unknown"))
   197	
   198	    # Exact match — allowed in either mode, no log.
   199	    if rec_workspace_id is not None and rec_workspace_id == identity.workspace_id:
   200	        return WorkspaceScopeResult(allowed=True, reason="workspace_match")
   201	
   202	    # Mismatch (or null workspace_id on the record).
   203	    if enforcing:
   204	        # WKSP-304 TASK-4.1: enforcing mode denies. A null workspace_id is
   205	        # treated as a mismatch — never defaulted to allowed (AC-3 / D3).
   206	        return WorkspaceScopeResult(allowed=False, reason="workspace_mismatch_denied")
   207	
   208	    # Advisory mode — unchanged from pre-Phase-4 WKSP-301 behaviour: log and allow.
   209	    trace_id = str(uuid.uuid4())
   210	    _logger.warning(
   211	        json.dumps(
   212	            {
   213	                "event": "workspace_scope_advisory_mismatch",
   214	                "trace_id": trace_id,
   215	                "record_type": record_type,
   216	                "record_id": record_id,
   217	                "record_workspace_id": rec_workspace_id,
   218	                "identity_workspace_id": identity.workspace_id,
   219	            }
   220	        )
   221	    )
   222	    return WorkspaceScopeResult(allowed=True, reason="advisory_mode")
   223	
   224	
   225	__all__ = [
   226	    "WorkspaceScopeResult",
   227	    "require_workspace_scope",
   228	    "resolve_workspace_isolation_active",
   229	]

