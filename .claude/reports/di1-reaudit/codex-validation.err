   400	def list_drafts(
   401	    paths: FoundryPaths, *, identity: AuthIdentity | None = None
   402	) -> list[dict[str, Any]]:
   403	    """Scan on-disk drafts (the source of truth) and return summaries.
   404	
   405	    ``identity`` is WKSP-304 Phase 3 query-layer scoping: threading it
   406	    straight into :func:`load_draft` is deliberate — that function already
   407	    raises :class:`NotFoundError` for a workspace mismatch when isolation is
   408	    active, and this loop already treats ``NotFoundError`` as "skip", so a
   409	    cross-workspace draft is filtered out of the listing for free, with the
   410	    single predicate living in one place (:func:`load_draft`) rather than
   411	    duplicated here. ``identity=None`` (the default) is byte-identical to the
   412	    pre-WKSP-304 listing.
   413	    """
   414	
   415	    root = paths.report_drafts
   416	    if not root.is_dir():
   417	        return []
   418	    out: list[dict[str, Any]] = []
   419	    for d in sorted(root.iterdir()):
   420	        if not d.is_dir():
   421	            continue
   422	        try:
   423	            draft = load_draft(paths, d.name, identity=identity)
   424	        except (NotFoundError, BuilderError):
   425	            continue
   426	        out.append(_summary_of(draft))
   427	    return out
