   175	_DEFAULT_RATE_LIMIT: dict[str, Any] = {}  # module-level default overrides (empty)
   176	
   177	
   178	def _resolve_workspace_id(request: Request) -> str:
   179	    """Return the caller's workspace_id, defaulting to ``"default"`` in no-auth mode."""
   180	    identity = getattr(request.state, "identity", None)
   181	    if identity is not None:
   182	        return identity.workspace_id
   183	    return "default"
