   205	def _paginate(items: list[dict], *, limit: int, offset: int) -> dict[str, Any]:
   206	    """Return the standard ``{"items", "total", "limit", "offset"}`` page envelope.
   207	
   208	    Simple offset-slice pagination over an already-materialized list — the
   209	    admin-scoped listings this backs (service accounts, tokens, PATs within
   210	    one workspace) are expected to be small, so no cursor/DB-level LIMIT is
   211	    needed. Mirrors ``audit.py``'s pagination *shape* (an ``items`` array
   212	    plus paging metadata) without inheriting its cursor mechanics, which are
   213	    unnecessary at this data volume.
   214	    """
   215	    total = len(items)
   216	    return {
   217	        "items": items[offset : offset + limit],
   218	        "total": total,
   219	        "limit": limit,
   220	        "offset": offset,
   221	    }
