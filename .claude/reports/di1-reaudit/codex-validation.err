   106	def build_server() -> Any:
   107	    """Construct and return a :class:`FastMCP` server with the router tools registered.
   108	
   109	    Lazily imports the MCP SDK; raises :class:`RuntimeError` with a clear
   110	    install hint if the SDK is missing. Returning the server object (rather
   111	    than running it) keeps this function unit-testable once the SDK is
   112	    available, and lets the caller (e.g. tests or a custom entry point) tune
   113	    transport / lifecycle settings.
   114	    """
   115	
   116	    try:
   117	        # FastMCP is the high-level decorator API in the official SDK.
   118	        from mcp.server.fastmcp import FastMCP  # type: ignore[import-not-found]
   119	    except ImportError as exc:  # noqa: BLE001 - re-raise as a clear runtime error
   120	        raise RuntimeError(_MISSING_SDK_MSG) from exc
   120	        raise RuntimeError(_MISSING_SDK_MSG) from exc
   121	
   121	
   122	    server = FastMCP("research-foundry-search-router")
   122	    server = FastMCP("research-foundry-search-router")
   123	
   123	
   124	    # --- core tools (spec §10.2) -----------------------------------------
   124	    # --- core tools (spec §10.2) -----------------------------------------
   125	
   125	
   126	    @server.tool()
   127	    def search_run(
   128	        request: dict[str, Any],
   129	        identity: dict[str, Any] | None = None,
   130	        sensitivity_threshold: str | None = None,
   131	        evidence_plan: dict[str, Any] | None = None,
   132	    ) -> dict[str, Any]:
   133	        """Execute a Search Router run.
   134	
   135	        ``request`` must validate against ``schemas/search_request.schema.yaml``
   136	        (at minimum: ``query`` and ``mode``). Returns the full ``search_run``
   137	        record produced by :func:`router.run_search`, including ``run_id``,
   138	        ``normalized_results``, ``source_cards``, ``metrics``, and (if any)
   139	        ``schema_errors``.
   140	
   141	        ``identity``, ``sensitivity_threshold``, and ``evidence_plan`` are
   142	        CARP-5.2 context passthroughs -- see the module docstring. All three
   143	        default to ``None``, reproducing the pre-CARP call exactly.
   144	        """
   145	
   146	        return run_search(
   147	            request,
   148	            identity=_identity_from_mapping(identity),
   149	            sensitivity_threshold=sensitivity_threshold,
   150	            evidence_plan=evidence_plan,
   151	        )
   152	
   153	    @server.tool()
   154	    def extract_url(urls: list[str]) -> dict[str, Any]:
   155	        """Extract Markdown from known URLs into source cards.
   156	
   157	        Thin wrapper over :func:`router.extract_urls`. Returns a dict with
   158	        ``run_id``, ``source_cards`` (list of source-card ids), and
   159	        ``degraded`` (True if any extraction fell through to content-empty).
   160	        """
   161	
   162	        return extract_urls(list(urls))
   163	
   164	    # --- mode-preset convenience tools -----------------------------------
   165	    #
   166	    # Each preset is a thin shim that fills in ``mode`` on the request before
   167	    # delegating to ``run_search``. They exist so an agent harness can call the
   168	    # router via a *named* tool ("search.source_discovery") that already
   169	    # encodes the intent, without forcing the agent to know the mode taxonomy.
   170	
   171	    def _with_mode(request: dict[str, Any], mode: str) -> dict[str, Any]:
   172	        merged = dict(request or {})
   173	        merged["mode"] = mode
   174	        return merged
   175	
   176	    def _run_search_with_context(
   177	        request: dict[str, Any],
   178	        identity: dict[str, Any] | None,
   179	        sensitivity_threshold: str | None,
   180	        evidence_plan: dict[str, Any] | None,
   181	    ) -> dict[str, Any]:
   182	        """Shared CARP-5.2 marshal-and-delegate tail for every mode preset."""
   183	
   184	        return run_search(
   185	            request,
