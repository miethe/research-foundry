     1	# rf-serve.service — systemd --user unit for Research Foundry loopback API server
     2	#
     3	# Environment file pattern:
     4	#   Create %h/.config/rf-serve/rf-serve.env with contents like:
     5	#     RF_SERVE_TOKEN=<your-secret-token>
     6	#   Permissions: chmod 600 ~/.config/rf-serve/rf-serve.env
     7	#
     8	# Enable and start:
     9	#   systemctl --user enable --now rf-serve
    10	#
    11	# NOTE: This unit is NOT auto-enabled. The operator must enable it manually.
    12	# NOTE: The [serve] extra must be installed:
    13	#   uv tool install --extra serve research-foundry   # or: pip install "research-foundry[serve]"
    14	# NOTE: Adjust ExecStart if `rf` is not on PATH; typical uv install path is %h/.local/bin/rf
    15	
    16	[Unit]
    17	Description=Research Foundry loopback API server (rf serve)
    18	Documentation=https://github.com/miethe/research-foundry
    19	After=network.target
    20	
    21	[Service]
    22	Type=simple
    23	
    24	# Load secrets from an environment file — do NOT inline secrets here.
    25	# Create the file with: install -Dm600 /dev/stdin ~/.config/rf-serve/rf-serve.env
    26	EnvironmentFile=%h/.config/rf-serve/rf-serve.env
    27	
    28	# Enable loopback API mode for the runs viewer
    29	Environment=RUNS_FRONTEND_LOOPBACK_API=true
    30	
    31	# Run rf serve; adjust path if uv placed the binary elsewhere (e.g. %h/.local/bin/rf serve)
    32	ExecStart=%h/.local/bin/rf serve
    33	
    34	Restart=on-failure
    35	RestartSec=5
    36	
    37	[Install]
    38	WantedBy=default.target

