   159	class CreateShareLinkBody(BaseModel):
   160	    """Body for POST /api/reports/{report_id}/share-links.
   161	
   162	    *sensitivity_threshold* defaults to the draft's own sensitivity label when
   163	    omitted.  The resolved threshold must be ``<=`` the draft's sensitivity rank
   164	    (creating a share link at a *higher* threshold than the draft's label is
   165	    permitted — the gate will still block access when the draft's label exceeds
   166	    the threshold at resolution time).
   167	
   168	    *expires_at* is an optional ISO-8601 UTC timestamp after which the link is
   169	    considered expired.  ``None`` means the link never expires (revocation is
   170	    the only mechanism to invalidate it).
   171	    """
   172	
   173	    sensitivity_threshold: str | None = None
   174	    expires_at: str | None = None
