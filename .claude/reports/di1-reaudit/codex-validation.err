   212	def _atomic_write_yaml(obj: dict[str, Any], path: Path) -> Path:
   213	    """Write YAML atomically: temp file in the same directory, then rename.
   214	
   215	    A crash mid-write must never leave a torn/partial ``draft.yaml`` or
   216	    revision snapshot — ``os.replace`` is atomic on the same filesystem, and
   217	    the temp file is unlinked on any failure before it is ever visible at
   218	    *path*.
   219	    """
   220	
   221	    path.parent.mkdir(parents=True, exist_ok=True)
   222	    fd, tmp_name = tempfile.mkstemp(dir=str(path.parent), prefix=f".{path.name}.", suffix=".tmp")
   223	    try:
   224	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
   225	            fh.write(dumps_yaml(obj))
   226	        os.replace(tmp_name, path)
   227	    except BaseException:
   228	        with suppress(OSError):
   229	            os.unlink(tmp_name)
   230	        raise
   231	    return path
