   189	
   190	def _record_event_inner(paths: FoundryPaths, event: AuditEvent) -> str:
   191	    """Internal implementation -- called inside record_event try/except."""
   192	    audit_event_id = str(uuid.uuid4())
   193	    created_at = datetime.now(tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%S") + "Z"
   194	    policy_json = (
   195	        json.dumps(event.policy_snapshot) if event.policy_snapshot is not None else None
   196	    )
   197	    redacted_detail = _redact_error_detail(event.error_detail)
   198	
   199	    conn = _connect(paths)
   200	    try:
   201	        _ensure_schema(conn)
   202	        conn.execute(
   203	            (
   204	                "INSERT INTO audit_event ("
   205	                "    audit_event_id, created_at, mutation_type, action, target_ref,"
   206	                "    actor_user_id, actor_workspace_id, source_ref, policy_snapshot,"
   207	                "    result, error_detail, trace_id, span_id"
   208	                ") VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)"
   209	            ),
   210	            (
   211	                audit_event_id,
   212	                created_at,
   213	                event.mutation_type,
   214	                event.action,
   215	                event.target_ref,
   216	                event.actor_user_id,
   217	                event.actor_workspace_id,
   218	                event.source_ref,
   219	                policy_json,
   220	                event.result,
   221	                redacted_detail,
   222	                event.trace_id,
   223	                event.span_id,
   224	            ),
   225	        )
   226	    finally:
   227	        conn.close()
   228	
   229	    _emit_otel_record_success(audit_event_id, event)
   230	    return audit_event_id
   231	
   232	
   233	def _emit_record_error(exc: Exception, event: AuditEvent) -> None:
   234	    """Log a structured ERROR and attempt an OTel error span."""
   235	    log.error(
   236	        "audit_service.record_event failed -- audit row dropped",
   237	        extra={
   238	            "mutation_type": event.mutation_type,
   239	            "action": event.action,
   240	            "target_ref": event.target_ref,
   241	            "actor_user_id": event.actor_user_id,
   242	            "actor_workspace_id": event.actor_workspace_id,
   243	            "result": event.result,
   244	            "error": str(exc),
   245	        },
   246	        exc_info=True,
   247	    )
   248	    # Soft-import OTel -- never require it.
   249	    try:
   250	        from opentelemetry import trace  # type: ignore[import]
   251	
   252	        tracer = trace.get_tracer("research_foundry.audit_service")
   253	        with tracer.start_as_current_span("audit_service.record_event") as span:
   254	            span.set_status(trace.StatusCode.ERROR, str(exc))
   255	            span.set_attribute("mutation_type", event.mutation_type)
   256	            span.set_attribute("action", event.action)
   257	    except Exception:  # OTel not available or span creation failed
   258	        pass
