   433	    request: Request,
   434	    config: FoundryConfig = _CONFIG_DEP,
   435	    _rbac: None = _RBAC_ADMIN,
   436	) -> dict[str, Any]:
   437	    """Return the current per-(identity, route) rate-limit budget.
   438	
   439	    Reflects any in-memory updates applied via ``PATCH /api/admin/rate-limit-config``.
   440	
   441	    ``per_identity`` and ``per_route`` are always ``true`` — they document the
   442	    keying strategy (one counter per ``(user_id, route)`` pair) rather than a
   443	    configurable option.
   444	
   445	    Access: owner / admin only.
   446	    """
   447	    return _read_rate_limit(request, config)
   448	
   449	
   450	# ---------------------------------------------------------------------------
   451	# PATCH /api/admin/rate-limit-config
   452	# ---------------------------------------------------------------------------
   453	
   454	
   455	@router.patch(
   456	    "/admin/rate-limit-config",
   457	    summary="Update rate-limit budget (in-memory, until next restart)",
   458	    tags=["admin"],
   459	)
   460	def update_rate_limit_config(
   461	    request: Request,
   462	    body: dict[str, Any] = Body(...),
   463	    config: FoundryConfig = _CONFIG_DEP,
   464	    _rbac: None = _RBAC_ADMIN,
   465	) -> dict[str, Any]:
   466	    """Apply in-memory overrides to the rate-limit budget.
   467	
   468	    Only the keys present in the body are updated; omitted keys retain their
   469	    current value.  Changes take effect for **new** requests immediately but
   470	    are not persisted to ``foundry.yaml`` — a server restart restores the
   471	    config-file defaults.
   472	
   473	    Accepted body fields:
   474	      ``max_requests``   (int)  — max requests per window per (user, route)
   475	      ``window_seconds`` (int)  — sliding window width in seconds
   476	
   477	    **Startup-only field (cannot be changed here)**:
   478	      ``enabled`` is wired into ``RateLimitMiddleware`` at startup from
   479	      ``foundry.yaml`` (``auth.rate_limit.enabled``).  The middleware reads
   480	      ``self._limiter`` only — it never consults ``app.state`` — so sending
   481	      ``enabled`` in the body has no effect on the running limiter.  Any
   482	      ``enabled`` key in the request body is silently ignored.
   483	
   484	    Returns the full updated config object on success.
   485	
   486	    Access: owner / admin only.
   487	    """
   488	    app_state = getattr(getattr(request, "app", None), "state", None)
   489	    if app_state is None:
   490	        raise HTTPException(status_code=500, detail="App state unavailable")
   491	
   492	    # Ensure overrides dict exists (should have been initialised by create_app).
   493	    if not hasattr(app_state, "rate_limit_overrides"):
   494	        app_state.rate_limit_overrides = {}
   495	
   496	    overrides: dict[str, Any] = app_state.rate_limit_overrides
   497	
   498	    # NOTE: "enabled" is intentionally not processed here.  It is a startup-only
   499	    # decision driven by foundry.yaml (auth.rate_limit.enabled) and wired into
   500	    # RateLimitMiddleware at process start.  The middleware reads self._limiter
   501	    # only; it never reads app.state, so toggling enabled here would have no
   502	    # effect.  Any "enabled" key in the request body is silently ignored.
   503	
   504	    if "max_requests" in body:
   505	        try:
   506	            val = int(body["max_requests"])
   507	        except (TypeError, ValueError) as exc:
   508	            raise HTTPException(status_code=422, detail="'max_requests' must be an integer") from exc
   509	        if val <= 0:
   510	            raise HTTPException(
   511	                status_code=422,
   512	                detail="'max_requests' must be >= 1 (same boundary as startup config)",
   513	            )
   514	        overrides["max_requests"] = val
   515	
   516	    if "window_seconds" in body:
   517	        try:
   518	            val = int(body["window_seconds"])
   519	        except (TypeError, ValueError) as exc:
   520	            raise HTTPException(status_code=422, detail="'window_seconds' must be an integer") from exc
   521	        if val <= 0:
   522	            raise HTTPException(
   523	                status_code=422,
   524	                detail="'window_seconds' must be >= 1 (same boundary as startup config)",
   525	            )
   526	        overrides["window_seconds"] = val
   527	
   528	    return _read_rate_limit(request, config)
   529	
   530	
   531	# ---------------------------------------------------------------------------
   532	# GET /api/admin/rbac-status
   533	# ---------------------------------------------------------------------------
   534	
   535	
   536	@router.get(
   537	    "/admin/rbac-status",
   538	    summary="RBAC enforcement state (read-only; any authenticated user)",
   539	    tags=["admin"],
   540	)
   541	def get_rbac_status(
   542	    request: Request,
   543	    config: FoundryConfig = _CONFIG_DEP,
   544	) -> dict[str, Any]:
   545	    """Return the current RBAC enforcement configuration.
   546	
   547	    Unlike other admin endpoints this route is accessible by **any
   548	    authenticated user** (no owner/admin gate) so that client-side code can
   549	    check whether the server is running in enforced or pass-through mode.
   550	
   551	    In single-operator mode (``auth.provider=none``, no identity on
   552	    ``request.state``) the endpoint is also accessible unconditionally.
   553	
   554	    Response shape:
   555	    ``rbac_enforcement``  (str)  — raw configured value (auto / disabled / enabled)
   556	    ``rbac_enforced``     (bool) — resolved effective state stored on app.state
   557	    ``auth_provider``     (str)  — active auth.provider value
   558	    """
   559	    # Resolved effective state (written by create_app).
   560	    app_state = getattr(getattr(request, "app", None), "state", None)
   561	    rbac_enforced: bool = bool(getattr(app_state, "rbac_enforced", False))
   562	
   563	    try:
   564	        enforcement = config.auth_rbac_enforcement()
   565	        enforcement_str = enforcement.value
   566	    except ValueError:
   567	        enforcement_str = str(config.auth.get("rbac_enforcement", "auto"))
   568	
   569	    try:
   570	        provider_name = config.auth_provider()
   571	    except ValueError:
   572	        provider_name = str(config.auth.get("provider", "none"))
   573	
   574	    return {
   575	        "rbac_enforcement": enforcement_str,
   576	        "rbac_enforced": rbac_enforced,
   577	        "auth_provider": provider_name,
   578	    }
   579	
   580	
   581	# ---------------------------------------------------------------------------
   582	# Token response helpers (Phase 3, ACT-301/ACT-302)
   583	# ---------------------------------------------------------------------------
   584	
   585	
   586	def _issued_token_response(issued: Any) -> dict[str, Any]:
   587	    """Serialize an ``IssuedToken`` for a one-time issuance response.
   588	
   589	    This is the ONLY place ``plaintext`` is ever put into a response body in
   590	    this router — every other token-shaped response goes through
   591	    :func:`_token_metadata` instead, which omits it.
   592	    """
   593	    return {
   594	        "token_id": issued.token_id,
   595	        "plaintext": issued.plaintext,
   596	        "token_prefix": issued.token_prefix,
   597	        "principal_type": issued.principal_type,
   598	        "principal_id": issued.principal_id,
   599	        "workspace_id": issued.workspace_id,
   600	        "role": issued.role,
   601	        "expires_at": issued.expires_at,
   602	    }
   603	
   604	
   605	def _token_metadata(row: dict[str, Any]) -> dict[str, Any]:
   606	    """Project an access-token row for list/get display — NEVER a secret.
   607	
   608	    *row* is one of the dicts returned by ``token_service.list_tokens`` /
   609	    ``token_service.get_token``, both of which already omit ``token_hash``
   610	    at the data layer. This helper is a second, router-level enforcement of
   611	    the same invariant, plus an explicit denylist of the plaintext key name,
   612	    so a future change to the token_service row shape cannot silently leak a
   613	    secret through this endpoint.
   614	    """
   615	    return {
   616	        "token_id": row["id"],
   617	        "principal_type": row["principal_type"],
   618	        "principal_id": row["principal_id"],
   619	        "workspace_id": row["workspace_id"],
   620	        "role": row["role"],
   621	        "token_prefix": row["token_prefix"],
   622	        "created_by": row.get("created_by"),
   623	        "created_at": row.get("created_at"),
   624	        "expires_at": row.get("expires_at"),
   625	        "revoked_at": row.get("revoked_at"),
   626	        "last_used_at": row.get("last_used_at"),
   627	    }
   628	
   629	
   630	# ---------------------------------------------------------------------------
   631	# Service accounts (Phase 3, ACT-301)
   632	# ---------------------------------------------------------------------------
   633	
   634	
   635	def _service_account_response(account: dict[str, Any]) -> dict[str, Any]:
   636	    """Project a ``service_accounts`` row for display.
   637	
   638	    Never a secret — accounts themselves never hold one; only their tokens
   639	    do (see :func:`_issued_token_response` / :func:`_token_metadata`).
   640	    """
   641	    return {
   642	        "id": account["id"],
   643	        "name": account["name"],
   644	        "workspace_id": account["workspace_id"],
   645	        "role": account["role"],
   646	        "description": account.get("description"),
   647	        "created_by": account.get("created_by"),
   648	        "created_at": account.get("created_at"),
   649	        "disabled_at": account.get("disabled_at"),
   650	    }
   651	
   652	
   653	def _get_service_account_or_404(
   654	    paths: FoundryPaths, account_id: str, workspace_id: str
   655	) -> dict[str, Any]:
   656	    """Return the ``service_accounts`` row for *account_id*, scoped to *workspace_id*.
   657	
   658	    404s uniformly for "unknown id" and "exists but in another workspace" —
   659	    the same cross-workspace-existence-hiding convention ``audit.py`` uses.
   660	    """

