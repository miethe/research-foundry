   178	# ---------------------------------------------------------------------------
   179	# Shared helpers
   180	# ---------------------------------------------------------------------------
   181	
   182	
   183	def _not_found(report_id: str, detail: str = "report draft not found") -> HTTPException:
   184	    """Return a 404 that does NOT leak whether the id is a wrong type vs absent.
   185	
   186	    Landmine #4: do not distinguish 'unknown rpt_ id' from 'this is a run id'.
   187	    """
   188	    return HTTPException(status_code=404, detail=detail)
   189	
   190	
   191	def _builder_error(exc: bsvc.BuilderError) -> HTTPException:
   192	    return HTTPException(status_code=422, detail=str(exc))
   193	
   194	
   195	def _resolve_threshold_rank(
   196	    paths: FoundryPaths, sensitivity_threshold: str | None, request: Request
   197	) -> int:
   198	    """Resolve the active sensitivity threshold to its rank (400 on a bogus label).
   199	
   200	    Mirrors ``get_run_anchors``' existence-gate pattern in ``runs.py`` and
   201	    ``catalog_service.get_item``'s fail-closed rank lookup, applied here to
   202	    Report Builder draft reads (R2 fix: these previously had zero sensitivity
   203	    gating at all).
   204	
   205	    The explicit ``?sensitivity_threshold=`` query param always takes
   206	    precedence; when omitted, falls back to the ``rf serve
   207	    --sensitivity-threshold`` override captured on ``app.state`` (see
   208	    ``runs._sensitivity_threshold_override`` — this router had the identical
   209	    gap as ``runs.py``'s GET endpoints: the CLI-flag override never reached
   210	    this gate, which always fell back to foundry.yaml's
   211	    ``viewer.sensitivity_threshold``).
   212	    """
   213	    effective = (
   214	        sensitivity_threshold
   215	        if sensitivity_threshold is not None
   216	        else _sensitivity_threshold_override(request)
   217	    )
   218	    try:
   219	        threshold = resolve_threshold(paths, effective)
   220	    except ExportError as exc:
   221	        raise HTTPException(status_code=400, detail=str(exc)) from exc
   222	    return SENSITIVITY_ORDER[threshold]
   223	
   224	
   225	def _sensitivity_rank(label: str | None) -> int:
   226	    """Fail-closed rank lookup — an unknown/missing label ranks stricter than
   227	    every known level (mirrors ``catalog_service._rank``), so it can never
   228	    silently pass a threshold gate."""
   229	    return SENSITIVITY_ORDER.get(str(label), len(SENSITIVITY_ORDER))
