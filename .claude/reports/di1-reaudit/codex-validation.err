   995	    if not target_user_id:
   996	        raise HTTPException(
   997	            status_code=422,
   998	            detail="'user_id' is required when there is no caller identity",
   999	        )
  1000	    if (
  1001	        identity is not None
  1002	        and target_user_id != identity.user_id
  1003	        and not _is_owner_or_admin(identity)
  1004	    ):
  1005	        raise HTTPException(
  1006	            status_code=403,
  1007	            detail="Insufficient role to issue a PAT on behalf of another user",
  1008	        )
  1009	
  1010	    workspace_id = _resolve_workspace_id(request)
